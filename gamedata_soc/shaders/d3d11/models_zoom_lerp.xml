<shader version="2">
	<normal>
		<pass vs="model_scope_lense" ps="model_scope_lense_lerp"/>
		<fog value="1"/>
		<zb test="1" write="1"/>
		<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
		<aref enable="1" value="0"/>
		<sorting priority="2" strict="1"/>
		<distort value="1"/>
		<texture name="s_base" value="{base}"/>
		<texture name="s_image" value="$user$accum"/>
		<texture name="s_velocity" value="$user$velocity2"/>
		<texture name="s_scope_ui" value="$user$ui_pda"/>
		<sampler name="smp_base"/>
		<sampler name="smp_rtlinear"/>
		<sampler name="smp_nofilter"/>
	</normal>
	<l_special>
		<shader_option name="USE_LENSE_LERP" value="1"/>
		<pass vs="scope_lense_mask" ps="scope_lense_mask"/>
		<zb test="0" write="1"/>
		<scope value="1"/>
		<fog value="0"/>
		<texture name="s_position" value="$user$position"/>
		<texture name="s_base" value="{base}"/>
		<sampler name="smp_base"/>
	</l_special>
</shader>
