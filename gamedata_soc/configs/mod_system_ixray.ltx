[dynamic_wallmark]:space_restrictor
GroupControlSection =
$spawn      = "ai\dynamic_wallmark"
$def_sphere = 1
class = DYNA_WM

shape_transp_color    = 135, 245, 66, 24

[auto_aiming]

; fraction of the full height of the target. 0.0 aim at legs, 1.0f aim at head
height_fraction = 0.72

; how easy it is to autoaim, 0-1, lerps between easy and norm
easiness = 0.0

; near, midnear, far distances a-b-c
distance_a = 1.0
distance_b = 4.0
distance_c = 80.0

; threshold angle differences for targets near and far
dotp_a_norm = 0.7
dotp_b_norm = 0.99
dotp_c_norm = 0.999999

dotp_a_easy = 0.7
dotp_b_easy = 0.8
dotp_c_easy = 0.9

; no weapon, aiming at chars to talk to them
; a-b works as easy
; b-c targets are ignored

![m_poltergeist_normal_tele];m_poltergeist.ltx
Tele_Time_Object_Keep					= 10000
Tele_Object_Min_Mass					= 0
Tele_Object_Max_Mass					= 10000

Tele_Shooting_From_Weapon_Enable        = on;                   Разрешает возможность стрелять с оружия по врагу.
Tele_Activate_N_Throw_Grenade           = on;                   Разрешает выдрать чеку и кинуть гранату во врага.
Tele_Max_Pickuped_Weapons				= 3; 					Кол-во стреляющего оружия, которое может быть захвачено телекинезом.
Tele_Delay_Before_First_Shoot			= 0; 				    Задержка перед первым выстрелом. (in ms)
Particle_Tele_Object					= static\fire_distort;	Проигрываемый партикл под предметом, чисто для красоты.

; Зачем нужены множители ниже?
; Без масштабирования реальная физическая энергия в рамках геймплея оказывается избыточной.
; Множитель позволяет искусственно снизить (поделить в N раз) или повысить урон для игрового баланса.
; Указывается в пределах: 0..1
; 1 = 100% урон, 0 - урон от попаданий предметами отключается, 0.5 - 50% урона.
Novice_Difficulty_Throwed_Object_Hit_Factor = 0.1
Stalker_Difficulty_Throwed_Object_Hit_Factor = 0.2
Veteran_Difficulty_Throwed_Object_Hit_Factor = 0.3
Master_Difficulty_Throwed_Object_Hit_Factor = 0.4

; Угловая скорость наведения оружия на врага.
; Указывается в градусах/с. 
; Нужно чтобы оружие не наводилось турель-like. Хотя, вы можете это сделлать, проставив везде 360.
Novice_Difficulty_Angular_Speed			= 180.0
Stalker_Difficulty_Angular_Speed		= 200.0
Veteran_Difficulty_Angular_Speed		= 240.0
Master_Difficulty_Angular_Speed			= 280.0

; Погрешность наведения на врага, после которой можно стрелять. Указывается в градусах/с (1..180)
; Чем ниже сложность - тем больше погрешность для начала стрельбы - тем больше будет потрачено патрон.
; Настраивается вместе с параметрами %difficulty%_Angular_Speed, чтобы при низких уровнях сложности - оружие в случае идеального наведения на модель врага.
; 1deg отклонения автоаима - оружие начнёт стрелять только в случае идеального наведения в центр модели врага.
; 180deg отклонения - оружие начинает стрелять, даже когда смотрит в противоположну сторону, относительно врага.
Novice_Difficulty_Error_Angle			= 30.0
Stalker_Difficulty_Error_Angle			= 20.0
Veteran_Difficulty_Error_Angle			= 15.0
Master_Difficulty_Error_Angle			= 8

![m_burer_e];m_burer.ltx
Tele_Time_To_Hold		 				= 10000
Tele_Object_Min_Mass					= 1
Tele_Object_Max_Mass					= 10000
Tele_Shooting_From_Weapon_Enable        = on;                   Разрешает возможность стрелять с оружия по врагу.
Tele_Activate_N_Throw_Grenade           = on;                   Разрешает выдрать чеку и кинуть гранату во врага.
Tele_Max_Pickuped_Weapons				= 1; 					Кол-во стреляющего оружия, которое может быть захвачено телекинезом.
Tele_Delay_Before_First_Shoot			= 0; 				    Задержка перед первым выстрелом. (in ms)
