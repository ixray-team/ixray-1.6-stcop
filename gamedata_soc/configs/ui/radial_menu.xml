			<window_name>rmw_drop_weapon</window_name>
			<text font="graffiti19" vert_align="c">ui_rmw_drop_weapon</text>
		</auto_static>
		<auto_static x="0" y="0" width="22" height="30">
			<window_name>rmw_night_vision</window_name>
			<text font="graffiti19" vert_align="c">ui_rmw_night_vision</text>
		</auto_static>
		<auto_static x="0" y="0" width="22" height="30">
			<window_name>rmw_wpn_func</window_name>
			<text font="graffiti19" vert_align="c">ui_rmw_wpn_func</text>
		</auto_static>
		<auto_static x="0" y="0" width="22" height="30">
			<window_name>rmw_fire_mode</window_name>
