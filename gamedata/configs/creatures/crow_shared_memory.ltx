; Общая память всех ворон на локации. Не резервирует лимиты заранее.
; Параметры читаются при инициализации общей памяти ворон.
; Перезагрузка освобождает кеш; текущие заявки ворон на корм сохраняются.
[crow_shared_memory]
corpse_limit = 0 ; Необязательный предел записей трупов, 0..65535; 0 — без ограничения числа, очистка по неиспользованию сохраняется.
observation_limit = 0 ; Необязательный предел ячеек наблюдений, 0..65535; 0 — без ограничения числа, удаляются неиспользуемые.
perches_per_corpse = 0 ; Сколько мест подготовить заранее при первом запросе, 0..128; 0 — только под реальное число кормящихся ворон плюс следующее место; это не предел.
corpse_refresh_ms = 0 ; Необязательный срок принудительного сброса мест, реальные мс, 0..3600000; 0 — только движение тела, неудача или использование места.
perch_search_attempts = 32 ; Число неудачных кандидатов перед паузой поиска у одного трупа, 1..1024; не предел хранимых мест.
perch_retry_ms = 2000 ; Пауза после исчерпания неудачных кандидатов, реальные мс, 250..60000; без повторного поиска каждый кадр.
corpse_idle_ms = 15000 ; Удалить запись трупа, если никто не запрашивал её столько реальных мс, 250..3600000.
corpse_move_distance = 0.05 ; Смещение тела или его габаритов, немедленно сбрасывающее места при следующем запросе, м, 0.005..1.
observation_refresh_ms = 250 ; Интервал обновления списка объектов в ячейке, реальные мс, 16..60000; позиции проверяются заново.
observation_idle_ms = 5000 ; Удалить ячейку после отсутствия запросов, реальные мс, 250..3600000.
observation_cell_size = 16 ; Ребро объёмной ячейки наблюдений, м, 2..128; это не плоский AI-граф.
maintenance_ms = 250 ; Интервал очистки просроченных записей, реальные мс, 16..10000.
perch_probes_per_frame = 2 ; Общий бюджет построения кандидатов у трупов за кадр для всей стаи, 1..64.
observation_queries_per_frame = 8 ; Общий бюджет обновлений пространственных наблюдений за кадр, 1..64.
