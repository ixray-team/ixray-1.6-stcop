<window>
    <compass_bar alignment="c" fade_in_speed="6" fade_out_speed="5" 
                 fov_angle="45" x="0.5" y="0.055" 
                 width="0.5" height="0.045" stretch="1">
        <background x="0" y="-0.625" width="1.0" height="1.0" alignment="l" stretch="1">
            <texture>no_texture</texture>
        </background>

        <strip x="0.050" y="0" width="0.89" height="1.0" tex_loop="1" tex_width="1024" stretch="1">
            <texture x="0" y="10" width="1.0" height="0.20">no_texture</texture>
            <cardinal_points alignment="c" x="0" y="0.15" width="0.065" height="0.4" stretch="1">
                <text align="c" font="ui_font_arial_14" vert_align="c" stretch="1"/>
                <main_cardinals>
                    <text align="c" font="ui_font_arial_14" colour="ui_1" vert_align="c" stretch="1"/>
                    <n>N</n>
                    <e>E</e>
                    <s>S</s>
                    <w>W</w>
                </main_cardinals>
                <!--
                <inter_cardinals>
                    <text align="c" font="ui_font_arial_14" colour="ui_1" vert_align="c" stretch="1"/>
                    <ne>NE</ne>
                    <se>SE</se>
                    <sw>SW</sw>
                    <nw>NW</nw>
                </inter_cardinals>
                -->
            </cardinal_points>
        </strip>

        <spots align="c" show="1" stretch="1">
        </spots>

        <active_target x="0" y="0" width="10" height="22" padding="8" smoothing_speed="10" stretch="1">
            <marker x="0" y="-5" width="20" height="20" texture="ui_inGame2_hint_wnd_main_window" stretch="1"/>
            <distance_text x="-3" y="-20" width="80" height="14" align="l" vert_align="c" color="ui_1">
                <text align="l" font="ui_font_arial_14" vert_align="c"/>
            </distance_text>
        </active_target>
    </compass_bar>
</window>
