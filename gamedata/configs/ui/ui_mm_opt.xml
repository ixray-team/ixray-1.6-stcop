					<e r="200" g="200" b="200"/>
				</text_color>
			</button>

			<button x="111" y="2" width="131" height="25" id="sound">
				<texture>ui_inGame2_opt_button_1</texture>
				<text font="letterica18" align="c">ui_mm_sound</text>
				<text_color>
					<e r="200" g="200" b="200"/>
				</text_color>
			</button>

			<button x="221" y="2" width="131" height="25" id="gameplay">
	            <texture>ui_inGame2_opt_button_1</texture>
	            <text font="letterica18" align="c">ui_mm_gameplay</text>
				<text_color>
					<e r="200" g="200" b="200"/>
				</text_color>
			</button>

			<button x="330" y="2" width="129" height="25" id="controls">
	            <texture>ui_inGame2_opt_button_2</texture>
	            <text font="letterica18" align="c">ui_mm_controls</text>
				<text_color>
					<e r="170" g="170" b="170"/>
				</text_color>
			</button>
		</tab>

        <templ_item width="430" height="30"/>

        <cap_template x="40" y="3" width="135" height="24">
            <text r="170" g="170" b="170" font="letterica16" align="r" vert_align="c"/>
        </cap_template>
        <selection_color r="255" g="255" b="255"/>
        <track_template_float x="190" y="6" width="235" height="16" show_value="1">
            <options_item entry="console_command_undefined_please_check_your_options_script" group="mm_opt_video_adv"/>
        </track_template_float>
        <track_template_int x="190" y="6" width="235" height="16" is_integer="1" show_value="1">
            <options_item entry="console_command_undefined_please_check_your_options_script" group="mm_opt_video_adv"/>
        </track_template_int>
        <check_template x="177" y="0.5" width="44" height="29">
	        <texture>ui_inGame2_checkbox</texture>
            <options_item entry="console_command_undefined_please_check_your_options_script" group="mm_opt_video_adv"/>
        </check_template>
        <list_template x="190" y="5" width="235" height="20">
            <options_item entry="console_command_undefined_please_check_your_options_script" group="mm_opt_video_adv"/>
