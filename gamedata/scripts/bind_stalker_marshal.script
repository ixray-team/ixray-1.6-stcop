end

----------------------------------------------------------------------------------------------------------------------
function script_ids(_binder, is_save_mode)
	if is_save_mode then
		SetStorageObjectVar(_binder.object:id(), "script_ids", db.script_ids)
		__log("[save] script_ids [%s]", tostring(ffx_json_lib.json_encode( db.script_ids )))
	else
		sim_board.get_sim_board().simulation_started = GetStorageObjectVar(_binder.object:id(), "script_ids", {})
		__log("[load] script_ids [%s]", tostring(ffx_json_lib.json_encode( db.script_ids )))
	end
end

----------------------------------------------------------------------------------------------------------------------
function active_slot(_binder, is_save_mode)
	if is_save_mode then
		SetStorageObjectVar(_binder.object:id(), "active_slot", _binder.object:active_slot())
		__log("[save] active_slot [%s]", tostring(ffx_json_lib.json_encode( _binder.object:active_slot() )))
	else
		_binder.loaded_active_slot = GetStorageObjectVar(_binder.object:id(), "active_slot", 0)
		_binder.loaded_slot_applied = false
		__log("[load] active_slot [%s]", tostring(ffx_json_lib.json_encode( _binder.loaded_active_slot )))
	end
end

----------------------------------------------------------------------------------------------------------------------
function deimos(_binder, is_save_mode)
	if is_save_mode then
		local deimos_objects = {}
		for k,v in pairs(db.zone_by_name) do
			if db.storage[v:id()] and db.storage[v:id()].active_scheme == "sr_deimos" then
				deimos_objects[v:id()] = db.storage[v:id()].sr_deimos.intensity
			end
		end
		
		SetStorageObjectVar(_binder.object:id(), "deimos_objects", deimos_objects)
		__log("[save] deimos_objects [%s]", tostring(ffx_json_lib.json_encode( deimos_objects )))
	else
		local deimos_objects = GetStorageObjectVar(_binder.object:id(), "deimos_objects", {})
		for k, v in pairs(deimos_objects) do
			if (db.storage[k] and db.storage[k].active_scheme == "sr_deimos") then
				db.storage[k].sr_deimos.intensity = v
				_binder.deimos_intensity = v
			end
		end
		__log("[load] deimos_objects [%s]", tostring(ffx_json_lib.json_encode( deimos_objects )))
	end
end

