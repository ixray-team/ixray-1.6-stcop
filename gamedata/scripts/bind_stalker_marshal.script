
local marshalLog = true

function __log(text, ...)
	if marshalLog then
		printf("-- [IXR MARHALIZE]:" .. text, ...)
		SemiLog("-- [IXR MARHALIZE]:" .. string.format(text, ...))
	end
end

----------------------------------------------------------------------------------------------------------------------
function game_difficulty(_binder, is_save_mode)
	local game_difficulty_by_num = {
		[0] = "gd_novice",
		[1] = "gd_stalker",
		[2] = "gd_veteran",
		[3] = "gd_master"
	}

	if is_save_mode then
		local game_difficulty = level.get_game_difficulty()
		SetStorageObjectVar(_binder.object:id(), "game_difficulty", game_difficulty)
		__log("[save] game_difficulty [%s]", tostring(game_difficulty))
		
	else
		local game_difficulty = GetStorageObjectVar(_binder.object:id(), "game_difficulty", 0)
		get_console():execute("g_game_difficulty " .. game_difficulty_by_num[game_difficulty])
		__log("[load] game_difficulty [%s]", tostring(game_difficulty))
	end
end

----------------------------------------------------------------------------------------------------------------------
function disable_input_time(_binder, is_save_mode)
	if is_save_mode then
		local stored_input_time = false
		if _binder.st.disable_input_time ~= nil then
			 stored_input_time = utils.get_table_CTime(_binder.st.disable_input_time)
		end
		
		SetStorageObjectVar(_binder.object:id(), "disable_input_time", stored_input_time)
		__log("[save] disable_input_time [%s]", tostring(ffx_json_lib.json_encode(stored_input_time)))
	else
		local stored_input_time = GetStorageObjectVar(_binder.object:id(), "disable_input_time", false)
		if stored_input_time then
			_binder.st.disable_input_time = utils.get_CTime_from_table(stored_input_time)
		else
			_binder.st.disable_input_time = nil
		end
		__log("[load] disable_input_time [%s]", tostring(ffx_json_lib.json_encode(stored_input_time)))
	end
end

