function level_name(_binder, is_save_mode)
	if is_save_mode then
		SetStorageObjectVar(_binder.object:id(), "last_level_name", tostring(_binder.last_level_name))
		__log("[save] last_level_name [%s]", tostring(ffx_json_lib.json_encode(_binder.last_level_name)))
	else
		_binder.last_level_name = GetStorageObjectVar(_binder.object:id(), "last_level_name", nil)
		__log("[load] last_level_name [%s]", tostring(ffx_json_lib.json_encode(_binder.last_level_name)))
	end
end

