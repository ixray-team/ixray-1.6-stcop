class "opt_video_adv" (CUIWindow)
function opt_video_adv:__init() super()
end

function opt_video_adv:__finalize()
end

function opt_video_adv:InitControls(x, y, xml, handler)
	self:SetWndPos(vector2():set(x,y))
	self:SetWndSize(vector2():set(738,416))
	self:SetAutoDelete(true)

	if xml:NodeExist("frame_videoadv", 0) then
		xml:InitFrame("frame_videoadv", self)
	end
	self.focusList = {}
	self.scroll_v = xml:InitScrollView("main_dialog:scroll_v", self)

	self.btn_simply = xml:Init3tButton("main_dialog:btn_template", self)
	self.btn_simply:SetTextST("ui_mm_simply")
	handler:Register(self.btn_simply, "btn_simply_graphic")

	handler:addVramBar(self, true)

	handler:lineFrame(self, true, "st_lights_options")
	handler:addComboBox(self, true, "ui_mm_shading_quality", "r_shading_quality", 4, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_shadow_quality", "r_shadow_quality", 5, false, system_depends.sdNothing, "shadowQuality")
	handler:addCheck(self, true, "ui_mm_pcss", "r_pcss", system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_volumetric_quality", "r_volumetric_quality", 5, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_occlusion_quality", "r_occlusion_quality", 3, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_screen_space_quality", "r_screen_space_quality", 2, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_reflection_quality", "r_reflection_quality", 4, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_gi_quality", "r_gi_quality", 3, false, system_depends.sdNothing)

	handler:lineFrame(self, true, "st_scene_options")
	handler:addComboBox(self, true, "ui_mm_culling_quality", "r_culling_quality", 2, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_geometry_quality", "r_geometry_quality", 2, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_streaming_quality", "r_streaming_quality", 4, false, system_depends.sdNothing, "streamingQuality")
	handler:addComboBox(self, true, "ui_mm_streaming_priority", "r_streaming_priority", 3, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_post_processing_quality", "r_post_processing_quality", 3, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_grass_quality", "r_grass_quality", 4, false, system_depends.sdNothing)
	handler:addTrack(self, true, "ui_mm_grass_distance", "r_grass_distance", 10, false, "int", true, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_distance_quality", "r_distance_quality", 4, false, system_depends.sdNothing)
	handler:addComboBox(self, true, "ui_mm_motion_vectors_quality", "r_motion_vectors_quality", 2, false, system_depends.sdNothing)
end
