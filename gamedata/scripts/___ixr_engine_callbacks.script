-- called from engine!
--[[
 Refers to when an icon is dragged onto another icon in Actor Inventory Menu
 
 passed parameters:
	first_item is the object being dragged; may be nil
	second_item is the object the item is being dragged onto; may be nil
	from_slot is the number value of the slot first_item is being dragged from;  0 or EDDListType.iInvalid is invalid 
	to_slot is the number value of the slot second_item is occupying;  0 or EDDListType.iInvalid is invalid 
	
from_slot and to_slot values:
		EDDListType.iInvalid			= 0
		EDDListType.iActorSlot			= 1
		EDDListType.iActorBag			= 2
		EDDListType.iActorBelt			= 3

		EDDListType.iActorTrade			= 4
		EDDListType.iPartnerTradeBag	= 5
		EDDListType.iPartnerTrade		= 6
		EDDListType.iDeadBodyBag		= 7
		EDDListType.iQuickSlot			= 8
		EDDListType.iTrashSlot			= 9
	
--]]
function CUIActorMenu_OnItemDropped(first_item, second_item, from_slot, to_slot)
	if not db.actor then
		return true;
	end
	
	local first_item_id = nil
	local first_item_section = nil
	if first_item then
		first_item_id = first_item:id() 
		first_item_section = first_item:section()
	end
	
	local second_item_id = nil
	local second_item_section = nil
	if second_item then
		second_item_id = second_item:id() 
		second_item_section = second_item:section()
	end
	
	if (first_item and second_item) then
		SendScriptCallback("CUIActorMenu_OnItemDropped", first_item, second_item, from_slot, to_slot)
		SendScriptCallback("ActorMenu_on_item_drag_drop", first_item, second_item, from_slot, to_slot)
	end
	
	if not first_item or not second_item or first_item:id() == second_item:id() then
		SendScriptCallback("actor_on_nil_drag_drop_item_on_item", first_item, second_item, from_slot, to_slot)
		
		return true
	end
	
	local actor_id = db.actor:id()
	if (first_item:parent() and first_item:parent():id() and first_item:parent():id() ~= actor_id) or (second_item:parent() and second_item:parent():id() and second_item:parent():id() ~= actor_id) then
		SendScriptCallback("actor_on_npc_drag_drop_item_on_item", first_item, second_item, from_slot, to_slot)
	else
		SendScriptCallback("actor_on_actor_drag_drop_item_on_item", first_item, second_item, from_slot, to_slot)
	end
	
	return true
end

