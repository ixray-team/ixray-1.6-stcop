-- called from engine!
-- useful for when doing npc:use(db.actor) when NPC is alive
-- basically what is available in the corpse loot menu while npc is alive
function CInventory_ItemAvailableToTrade(npc, item)
	
	local flags = { ret_value = true }
	
	SendScriptCallback("CInventory_ItemAvailableToTrade", npc, item, flags)
	
	return flags.ret_value
end

-- called from engine!
function level_on_key_press(dik,bind)
	if (level.present() and db.actor) then	
		SendScriptCallback("level_input_on_key_press", dik, bind)
	end
	
	return false
end

