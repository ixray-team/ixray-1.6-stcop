-- #######################################
-- #	 	 	CALLBACKS				 #
-- #######################################
function on_game_start()
	RegisterScriptCallback("main_menu_on_init", this.on_main_menu_init)
	RegisterScriptCallback("main_menu_on_init_controlls", this.on_main_menu_init_controlls)
	RegisterScriptCallback("main_menu_on_init_callbacks", this.on_main_menu_init_callbacks)
	RegisterScriptCallback("main_menu_update", this.on_main_menu_update)
	RegisterScriptCallback("actor_on_update", this.on_actor_update)
	
	_load_options()
end

function on_main_menu_init(_ref)
	_on_main_menu_init(_ref)
end

function on_main_menu_init_callbacks(_ref)
	_on_main_menu_init_callbacks(_ref)
end

function on_main_menu_init_controlls(_ref)
	_on_main_menu_init_controlls(_ref)
end

function on_actor_update(_ref)
	_on_main_menu_update(_ref)
end

function on_main_menu_update(_ref)
	_on_main_menu_update(_ref)
end

-- #######################################
-- #	 	 PUBLIC METHODS 	  	 	 #
