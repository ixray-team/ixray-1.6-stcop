-- #############################################
-- #			GAME PAD HOOKS 				   #
-- #############################################

-- обрабатываем нажатия
function on_gamepad_key(key, action)
	if not is_options_opened() then
		return false
	end
	
	local bind = dik_to_bind(key)
	local bindUI = dik_to_bind(key, action_groups.agUIGeneral)
	
	if action and action ~= ui_events.WINDOW_KEY_PRESSED then
		return false
	end
	
	if bindUI == key_bindings.kUI_BACK then
		return ixr_options.emulate_back()
	elseif bindUI == key_bindings.kUI_ACCEPT then
		return ixr_options.emulate_accept()
	elseif bindUI == key_bindings.kUI_UP then
		action_repeaters():SetActionStarted(get_menu_ref(), key_bindings.kUI_UP)
		if not any_binded_key_for_action_pressed_c(key_bindings.kUI_DOWN) then
			return ixr_options.emulate_up(false)
		end
	elseif bindUI == key_bindings.kUI_DOWN then
		action_repeaters():SetActionStarted(get_menu_ref(), key_bindings.kUI_DOWN)
		if not any_binded_key_for_action_pressed_c(key_bindings.kUI_UP) then
			return ixr_options.emulate_down(false)
		end
	elseif bindUI == key_bindings.kUI_LEFT then
		action_repeaters():SetActionStarted(get_menu_ref(), key_bindings.kUI_LEFT)
		if not any_binded_key_for_action_pressed_c(key_bindings.kUI_RIGHT) then
			return ixr_options.emulate_left(false)
		end
	elseif bindUI == key_bindings.kUI_RIGHT then
		action_repeaters():SetActionStarted(get_menu_ref(), key_bindings.kUI_RIGHT)
		if not any_binded_key_for_action_pressed_c(key_bindings.kUI_LEFT) then
			return ixr_options.emulate_right(false)
		end
	end
	
	return false
end

-- обрабатываем удержания
function on_gamepad_key_hold(key, action)
	if not is_options_opened() then
		return false
	end
	
	local bind = dik_to_bind(key)
	local bindUI = dik_to_bind(key, action_groups.agUIGeneral)
	
	if action and action ~= ui_events.WINDOW_KEY_PRESSED then
		return false
	end
	
	if bindUI == key_bindings.kUI_UP then
		if action_repeaters():CanRepeatActionNow(get_menu_ref(), key_bindings.kUI_UP)
		and not any_binded_key_for_action_pressed_c(key_bindings.kUI_DOWN) then
			return ixr_options.emulate_up(true)
		end
	elseif bindUI == key_bindings.kUI_DOWN then
		if action_repeaters():CanRepeatActionNow(get_menu_ref(), key_bindings.kUI_DOWN)
		and not any_binded_key_for_action_pressed_c(key_bindings.kUI_UP) then
			return ixr_options.emulate_down(true)
		end
	elseif bindUI == key_bindings.kUI_LEFT then
		if action_repeaters():CanRepeatActionNow(get_menu_ref(), key_bindings.kUI_LEFT)
		and not any_binded_key_for_action_pressed_c(key_bindings.kUI_RIGHT) then
			return ixr_options.emulate_left(true)
		end
	elseif bindUI == key_bindings.kUI_RIGHT then
		if action_repeaters():CanRepeatActionNow(get_menu_ref(), key_bindings.kUI_RIGHT)
		and not any_binded_key_for_action_pressed_c(key_bindings.kUI_LEFT) then
			return ixr_options.emulate_right(true)
		end
	end
	
	return false
end

function on_press_key(dik, action, is_hold)
	if not DEBUG_GAMEPAD_KEYBOARD_EMULATE or not is_options_opened() then
		return false
	end
	
	if action and action ~= ui_events.WINDOW_KEY_PRESSED then
		return false
	end
	
	if dik == DIK_keys.DIK_ESCAPE then
		on_ixr_options_exit_btn_clicked()
		return true
	else
		if dik == DIK_keys.DIK_NUMPAD0 then
			return ixr_options.emulate_back()
		elseif dik == DIK_keys.DIK_NUMPAD5 then
			return ixr_options.emulate_accept()
		elseif dik == DIK_keys.DIK_NUMPAD8 then
			return ixr_options.emulate_up(is_hold)
		elseif dik == DIK_keys.DIK_NUMPAD2 then
			return ixr_options.emulate_down(is_hold)
		elseif dik == DIK_keys.DIK_NUMPAD4 then
			return ixr_options.emulate_left(is_hold)
		elseif dik == DIK_keys.DIK_NUMPAD6 then
			return ixr_options.emulate_right(is_hold)
		end
	end
	
	return false
end

-- #######################################
-- #	  UI GAMEPAD CONTROLL 	 	 	 #
-- #######################################
local selection_addon_index = 0
local selected_option_index = 0
local selection_row = 1
local option_focused = false

function ixr_options.emulate_back()
	if option_focused then
		ixr_options.reset_focused_options()
	else
		on_ixr_options_exit_btn_clicked()
	end
end

function ixr_options.emulate_accept()
	if not option_focused and selection_row > 1 then
		if selected_option_index > 0 and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] then
			ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_focused_controll_ref:Show(true)
			option_focused = true
		end
	else
		ixr_options.reset_focused_options()
	end
end

function ixr_options.emulate_up(is_hold)
	if option_focused then
		return true
	end
	
	if ixr_options.gamepad_supported_controlls.is_controlls_rendering_completed then

	end
	
	-- листаем аддоны
	if selection_row == 1 then
		if selection_addon_index > 0 and ixr_options.gamepad_supported_controlls.addons[selection_addon_index] then
			ixr_options.gamepad_supported_controlls.addons[selection_addon_index].addon_controll_ref:SetSelectedState(false)
		end
		
		selection_addon_index = selection_addon_index - 1
		selected_option_index = 0
		
		if selection_addon_index < 1 then
			selection_addon_index = 1
		end
		
		if ixr_options.gamepad_supported_controlls.addons[selection_addon_index] then
			get_controll("addons_list_box"):SetSelectedIndex(selection_addon_index - 1)
			OnAddonItemClicked()
			
			local pos = get_controll("addons_list_box"):GetSelectedIndex() * get_controll("addons_list_box"):GetItemHeight();
			pos = pos - get_controll("addons_list_box"):GetHeight()/2;
			if pos < 0 then
				pos = 0
			end

			get_controll("addons_list_box"):SetScrollPos(pos);
	
			ixr_options.gamepad_supported_controlls.addons[selection_addon_index].addon_controll_ref:SetSelectedState(true)
		end
	end
	
	-- листаем опции
	if selection_row > 1 then
		if ixr_options.gamepad_supported_controlls.is_controlls_rendering_completed then			
			if selected_option_index > 0 and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] then
				ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_selected_controll_ref:Show(false)
			end
			
			selected_option_index = selected_option_index - 1
		
			if selected_option_index < 1 then
				selected_option_index = 1
			end

			local bar = get_controll("options_scroll"):ScrollBar()
			local barHeight = bar:GetHeight()
			local scroll = get_controll("options_scroll")
			scroll:ScrollToItem(ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_focused_controll_ref:GetParent():GetParent(), 
														math.floor(-barHeight / 2 + ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_focused_controll_ref:GetParent():GetParent():GetHeight() / 2))
		
			if ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] then
				ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_selected_controll_ref:Show(true)
			end
		end
	end
	
	ixr_options.reset_focused_options()
end

function ixr_options.emulate_down(is_hold)
	if option_focused then
		return true
	end
	
	-- листаем аддоны
	if selection_row == 1 then
		if selection_addon_index > 0 and ixr_options.gamepad_supported_controlls.addons[selection_addon_index] then
			ixr_options.gamepad_supported_controlls.addons[selection_addon_index].addon_controll_ref:SetSelectedState(false)
		end
		
		selection_addon_index = selection_addon_index + 1
		selected_option_index = 0
		
		if selection_addon_index > #ixr_options.gamepad_supported_controlls.addons then
			selection_addon_index = #ixr_options.gamepad_supported_controlls.addons
		end
		
		if ixr_options.gamepad_supported_controlls.addons[selection_addon_index] then
			get_controll("addons_list_box"):SetSelectedIndex(selection_addon_index - 1)
			OnAddonItemClicked()
			
			local pos = get_controll("addons_list_box"):GetSelectedIndex() * get_controll("addons_list_box"):GetItemHeight();
			pos = pos - get_controll("addons_list_box"):GetHeight() / 2;
			if pos < 0 then
				pos = 0
			end

			get_controll("addons_list_box"):SetScrollPos(pos);
	
			ixr_options.gamepad_supported_controlls.addons[selection_addon_index].addon_controll_ref:SetSelectedState(true)
		end
	end
	
	-- листаем опции
	if selection_row > 1 then
		if ixr_options.gamepad_supported_controlls.is_controlls_rendering_completed then
			if selected_option_index > 0 and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] then
				ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_selected_controll_ref:Show(false)
			end
			
			selected_option_index = selected_option_index + 1
			
			if selected_option_index > #ixr_options.gamepad_supported_controlls.options_controlls then
				selected_option_index = #ixr_options.gamepad_supported_controlls.options_controlls
			end

			local bar = get_controll("options_scroll"):ScrollBar()
			local barHeight = bar:GetHeight()
			local scroll = get_controll("options_scroll")
			scroll:ScrollToItem(ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_focused_controll_ref:GetParent():GetParent(), 
														math.floor(-barHeight / 2 + ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_focused_controll_ref:GetParent():GetParent():GetHeight() / 2))
					
			if ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] then
				ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].background_selected_controll_ref:Show(true)
			end
		end
	end
	
	ixr_options.reset_focused_options()
end

function ixr_options.emulate_left(is_hold)
	--  выбираем аддоны либо контролы
	if not option_focused then
		selection_row = selection_row - 1
		if selection_row < 1 then
			selection_row = 1
		end
		
		if selection_row == 1 then
			get_controll("framewindow_gamepad"):SetWndPos(vector2():set(33, 108))
			get_controll("framewindow_gamepad"):SetWndSize(vector2():set(250, 575))
			ixr_options.reset_selection_options()
			ixr_options.reset_focused_options()
		end
	end
	
	-- контрол выбран крутим в лево в право его значения
	if option_focused then
		if selected_option_index > 0 and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].controll_ref then
			if ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].controll_ref.on_gamepad_left then
				ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].controll_ref:on_gamepad_left(is_hold)
			end
		end
	end
end

function ixr_options.emulate_right(is_hold)
	--  выбираем аддоны либо контролы
	if not option_focused then
		if selection_addon_index == 0 then
			return
		end
		
		selection_row = selection_row + 1
		if selection_row > 2 then
			selection_row = 2
		end
		
		if selected_option_index == 0 then
			get_controll("framewindow_gamepad"):SetWndPos(vector2():set(320, 125))
			get_controll("framewindow_gamepad"):SetWndSize(vector2():set(670, 550))
			ixr_options.select_first_option()
			ixr_options.reset_focused_options()
		end
	end
	
	-- контрол выбран крутим в лево в право его значения
	if option_focused then
		if selected_option_index > 0 and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index] and ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].controll_ref then
			if ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].controll_ref.on_gamepad_right then
				ixr_options.gamepad_supported_controlls.options_controlls[selected_option_index].controll_ref:on_gamepad_right(is_hold)
			end
		end
	end
end

function ixr_options.reset_focused_options()
	option_focused = false
	for i,v in ipairs(ixr_options.gamepad_supported_controlls.options_controlls) do
		v.background_focused_controll_ref:Show(false)
	end
end

function ixr_options.select_first_option()
	ixr_options.gamepad_supported_controlls.options_controlls[1].background_selected_controll_ref:Show(true)
	selected_option_index = 1
end

function ixr_options.reset_selection_options()
	selected_option_index = 0
	for i,v in ipairs(ixr_options.gamepad_supported_controlls.options_controlls) do
		v.background_selected_controll_ref:Show(false)
	end
end

-- #######################################
-- #	   GAMEPAD COLLECT INFO 		 #
-- #######################################
-- событие перед выходом из опций чистит данные о контроллах (перед скрытием опций)
function on_before_clear_controlls_and_addons_info_gamepads()
	ixr_options.gamepad_supported_controlls = {
		is_controlls_rendering_completed = false,
		options_controlls = {},
		addons = {},
	}
end

-- контроллы отрендерены можно использовать метаданные (вызывается после отрисовки правой части опций)
function on_controlls_rendering_completed()
	ixr_options.gamepad_supported_controlls.is_controlls_rendering_completed = true
	
	local addons = ixr_options.gamepad_supported_controlls.options_controlls
	local controlls = ixr_options.gamepad_supported_controlls.addons
end

-- событие о чистке данных контролов для геймпада (вызывается перед отрисовкой правой части опций)
function on_before_clear_controlls_info_gamepads()
	ixr_options.gamepad_supported_controlls.options_controlls = {}
	ixr_options.gamepad_supported_controlls.is_controlls_rendering_completed = false
end

-- регистрирует информацию о контролле
function register_controll_metadata_for_gamepad(script_file_name, variable_name, _metadata)
	if ixr_options.gamepad_supported_controlls.options_controlls == nil then
		ixr_options.gamepad_supported_controlls.options_controlls = {}
	end

	local idx = #ixr_options.gamepad_supported_controlls.options_controlls
	table.insert(ixr_options.gamepad_supported_controlls.options_controlls, {
		controll_type = _metadata.controll_type,
		controll_ref = _metadata.controll_ref,
		script_name = _metadata.script_name,
		variable_name = _metadata.variable_name,
		background_focused_controll_ref = _metadata.background_focused_controll_ref,
		background_selected_controll_ref = _metadata.background_selected_controll_ref,
		background_controll_ref = _metadata.background_controll_ref,
		background_controll_color = _metadata.background_controll_color,
		label_controll_ref = _metadata.label_controll_ref,
		label_controll_color = _metadata.label_controll_color,
		idx = idx + 1
	})
end

-- регистрирует информацию об аддоне
function register_addon_for_gamepad(script_file_name, ref)
	if ixr_options.gamepad_supported_controlls.addons == nil then
		ixr_options.gamepad_supported_controlls.addons = {}
	end
	
	local idx = #ixr_options.gamepad_supported_controlls.addons
	table.insert(ixr_options.gamepad_supported_controlls.addons, {
		addon_controll_ref = ref,
		script_file_name = script_file_name,
		idx = idx + 1
	})
end

-- #######################################
-- #	 	 	SYSTEM METHODS 	  	 	 #
-- #######################################
function ixr_options.is_options_opened()
	return ixr_options.dynamic_vars.menu_opened
end

function ixr_options.is_initialized()
	return ixr_options.initialized
end

function ixr_options.init()
	IXRLogUseFileLog(ixr_options.use_file_log)
	IXRLogUseConsoleLog(ixr_options.use_console_log)
	IXRLogUseTimeInLog(ixr_options.use_time_log)
	
	if ixr_options.is_initialized() then
		return true
	end

	ixr_options.initialized = false

	IXRLog("[IXR OPTIONS] PREPARE INIT")
	
	RegisterScriptCallback("on_ixr_autoloader_initialized", ixr_options.on_all_scripts_loaded)

	ixr_options.initialized = true

	IXRLog("[IXR OPTIONS] INITIALIZED")
	
	--[[
	local addons_data = get_addons_list()

	for i, addon_data in ipairs(addons_data) do
		IXRLog("ADDON: " .. i .. ": " .. addon_data.addon_folder)
		for j, script_name in ipairs(addon_data.script_files_names) do
			IXRLog("  ADDON‚ " .. j .. ": " .. script_name)
		end
	end
	--]]
	
	return true
end

function _on_main_menu_update(_ref)
	if ixr_options.__timer <= device().dwtime_continual then 
		ixr_options.__timer = device().dwtime_continual + 100

		for k, v in pairs(ixr_options.update_bus) do
			if type(v) == "function" then v() end
		end
	end
	if _ref.main_xml ~= nil then
		get_controll("framewindow_gamepad"):Show(main_menu.in_controller_mode() and ixr_options.is_options_opened())
		
		-- for gamepad legend
		local text_accept		= get_menu_ref():GetStatic("framework_gp_accept")	
		if text_accept then
			text_accept:Show(selection_row > 1)
		end

		local text_lr		= get_menu_ref():GetStatic("framework_gp_lr")	
		if text_lr then
			if option_focused then
				text_lr:SetTextST("st_ixray_framework_options_lr_focused")
			else
				text_lr:SetTextST("st_ixray_framework_options_lr")
			end
		end

		local text_ud		= get_menu_ref():GetStatic("framework_gp_ud")	
		if text_ud then
			if selection_row == 1 then
				text_ud:SetTextST("st_ixray_framework_addons_ud")
			else
				text_ud:SetTextST("st_ixray_framework_options_ud")
			end
			text_ud:Show(not option_focused)
		end
	end
end

function set_main_menu_update(name, _callable)
	ixr_options.update_bus[name] = _callable
end

function _load_options()
	if ixr_options.options_storage_loaded then
		return
	end
	
	ixr_options.options_storage_loaded = true
	IXRLog("[IXR OPTIONS] BEGIN LOAD OPTIONS BY FILE")
	local stored_options_string = ffx_io_utils.read_string_file_(_get_option_storage_path(), false)
	if stored_options_string then
		local tmp_opt_storage = ffx_json_lib.json_decode(stored_options_string) or {}
		local need_resave = false
		for k, v in pairs(tmp_opt_storage) do
			if type(v) ~= "table" then
				need_resave = true
			else
				need_resave = v.metadata == nil
			end
			break
		end
	
		if need_resave then
			ffx_io_utils.write_string_file(ffx_json_lib.json_encode(ixr_options.options_storage), _get_option_storage_path(), "w+")
			IXRLog("[IXR OPTIONS] CREATE NEW OPTIONS FILE [ACTUALIZE VERSION]")
		else
			ixr_options.options_storage = tmp_opt_storage
		end
		
		IXRLog("[IXR OPTIONS] LOAD OLD OPTIONS FILE")
		IXRLog("[IXR OPTIONS] LOADED [" .. tostring(ffx_table_utils.get_size(ixr_options.options_storage)) .. "] OPTIONS")
	else
		ffx_io_utils.write_string_file(ffx_json_lib.json_encode(ixr_options.options_storage), _get_option_storage_path(), "w+")
		IXRLog("[IXR OPTIONS] CREATE NEW OPTIONS FILE")
	end
	IXRLog("[IXR OPTIONS] END LOAD OPTIONS BY FILE")
	
	IXRLog("[IXR OPTIONS] DUMP:[ixr_options.options_storage]:")
	IXRLogEmptyLine()
	IXRLogEmptyLine()
	IXRLog(ffx_dump_utils.var_export(ixr_options.options_storage))
end

function _save_options()
	_on_main_menu_update(get_menu_ref())
	ffx_io_utils.write_string_file(ffx_json_lib.json_encode(ixr_options.options_storage), _get_option_storage_path(), "w+")
	IXRLog("IXR Options saved ...")
end


-- #######################################
-- #	 	OPTIONS REGISTRATOR 	 	 #
-- #######################################

function ixr_options.on_all_scripts_loaded(_ref)
	IXRLog("[IXR OPTIONS] INIT SCRIPTS OPTIONS BEGIN")
	IXRLogEmptyLine()
	IXRLogEmptyLine()
	
	SendScriptCallback("on_init_ixr_options", ixr_options)
	
	IXRLog("[IXR OPTIONS] INIT SCRIPTS OPTIONS END")
	IXRLogEmptyLine()
	IXRLogEmptyLine()
	
	if ixr_options.options_storage_loaded then
		IXRLog("[IXR OPTIONS] BEGIN SEND EVENTS TO SCRIPTS BY LOADED VALUES")
		IXRLogEmptyLine()
		IXRLogEmptyLine()
		--IXRLog("[IXR OPTIONS] DUMP:[ixr_options.options]:\n\n" .. ffx_dump_utils.var_export(ixr_options.options))
		
		for file_name, file_options in pairs(ixr_options.options) do
			for index, option_data in pairs(file_options) do
				if option_data.controll_data ~= nil and option_data._callback then
					local actual_value = ixr_options.get_stored_variable(option_data.script_name, option_data.variable_name, option_data.controll_data.default_value)
					local group_name = option_data.group_name or nil
					local variable_name = option_data.variable_name or nil
					
					if option_data._callback ~= nil then
						local is_value_from_code = true
						if option_data.controll_data.controll == "combo_box" then
							actual_value = option_data.controll_data.list_values[actual_value].option_return_value
							option_data._callback(group_name, variable_name, actual_value, is_value_from_code)
						else
							option_data._callback(group_name, variable_name, actual_value, is_value_from_code)
						end
						
						IXRLog( "[IXR OPTIONS] RUN CALLBACK::[" .. tostring(option_data.script_name) .. ".script] -> { group_name:[" .. tostring(group_name) .. "] variable_name:[" .. tostring(variable_name) .. "] actual_value:[" .. tostring(ffx_json_lib.json_encode(actual_value)) .. "]" )
					end
				end
			end
		end

		IXRLog("[IXR OPTIONS] END SEND EVENTS TO SCRIPTS BY LOADED VALUES")
		IXRLogEmptyLine()
		IXRLogEmptyLine()
	end
end

function ixr_options.has_variable_value(script_name, var_name)
	return (ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)] ~= nil)
end

function ixr_options.get_stored_variable(script_name, var_name, default_value)
	if not ixr_options.has_variable_value(script_name, var_name) then
		return default_value
	end
	
	return ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)].value
end

function ixr_options.get_variable_value(script_name, var_name, default_value)
	if (not ixr_options.options_storage_loaded) or (not ixr_options.options[script_name]) then
		return default_value
	end
	
	for index, option_data in pairs(ixr_options.options[script_name]) do
		if option_data.variable_name == var_name and option_data.controll_data ~= nil then
			local actual_value = ixr_options.get_stored_variable(option_data.script_name, option_data.variable_name, option_data.controll_data.default_value)

			if option_data.controll_data.controll == "combo_box" then
				actual_value = option_data.controll_data.list_values[actual_value].option_return_value
			end
			
			return actual_value
		end
	end

	return default_value
end

function ixr_options.set_variable_value(script_name, var_name, value)
	ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)] = {value = value, metadata = ixr_options.get_metadata(script_name, var_name)}
end

function ixr_options.remove_variable_value(script_name, var_name)
	ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)] = nil
end

function ixr_options.build_variable_key(script_name, var_name)
	return tostring(script_name) .. "_" .. tostring(var_name)
end

function ixr_options.get_metadata(script_name, var_name)
	if ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)] ~= nil then
		return ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)].metadata
	end
	
	return {}
end

function ixr_options.set_metadata(script_name, var_name, metadata)
	if ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)] ~= nil then
		ixr_options.options_storage[ixr_options.build_variable_key(script_name, var_name)].metadata = metadata
	end
end

function ixr_options.register_option(group_name, variable_name, display_text, controll_data, _callback)
	local script_name = ffx_callable_utils.find_caller_source(3)
	IXRLog("[IXR OPTIONS]::[REGISTER]:: script_name:[" .. tostring(script_name) .. "] group_name:[" .. tostring(group_name) .. "] variable_name:[" .. tostring(variable_name) .."] controll_data:[" .. tostring(ffx_json_lib.json_encode(controll_data)) .."]")
	
	if ixr_options.options[script_name] == nil then
		ixr_options.options[script_name] = {}
	end

	for k, v in pairs(ixr_options.options[script_name]) do
		if v["variable_name"] == variable_name then
			IXRLog("[IXR OPTIONS] SKIP DUPLICATE KEY: " .. tostring(script_name) .. "[" .. tostring(variable_name).. "]")
			return
		end
	end
	
	if tostring(type(controll_data)) == "table" then
		controll_data["default_value"] = ixr_options.get_stored_variable(script_name, variable_name, controll_data["default_value"])
		ixr_options.set_variable_value(script_name, variable_name, controll_data["default_value"])
	end

	table.insert(ixr_options.options[script_name], {
		["addon"] = "00000000-0000-0000-0000-00000000",
		["script_name"] = script_name,
		["group_name"] = group_name,
		["variable_name"] = variable_name,
		["display_text"] = display_text,
		["controll_data"] = controll_data,
		["_callback"] = _callback,
	})
end

