-- #######################################
-- #	  MAIN MENU OVERRIDE UI 	 	 #
-- #######################################

function _on_main_menu_init(_ref)
	set_menu_ref(_ref)
	get_menu_ref().options_xml = CScriptXmlInit()
	get_menu_ref().options_xml:ParseFile("ui_ixr_options.xml")
	ixr_options.main_menu_ref.ixr_controlls = {}
end

function _on_main_menu_init_callbacks(_ref)
	set_menu_ref(_ref)
	
	get_menu_ref().ixr_options_btn = get_menu_ref().options_xml:Init3tButton("ixr_options_btn", get_menu_ref())
	get_menu_ref().ixr_options_btn:SetWndPos(vector2():set(get_menu_ref().ixr_options_btn:GetWndPos().x * ui.get_current_kx(), get_menu_ref().ixr_options_btn:GetWndPos().y))
    get_menu_ref().ixr_options_btn:SetWidth(get_menu_ref().ixr_options_btn:GetWidth()*ui.get_current_kx())
	get_menu_ref():Register(get_menu_ref().ixr_options_btn, "ixr_options_btn")
	get_menu_ref():AddCallback("ixr_options_btn", ui_events.BUTTON_CLICKED, this.on_btn_options_ixr_clicked, get_menu_ref())
end

function on_ixr_options_exit_btn_clicked()
	ixr_options.dynamic_vars.menu_opened = false
	hide_options()
	get_menu_ref().ixr_options_btn:Show(true)
	if get_menu_ref().shniaga then
		get_menu_ref().shniaga:Show(true)
		get_menu_ref().shniaga:SetVisibleMagnifier(true)
	end
	if get_menu_ref().eng_lang_btn then get_menu_ref().eng_lang_btn:Show(true) end
	if get_menu_ref().ru_lang_btn then get_menu_ref().ru_lang_btn:Show(true) end
	if get_menu_ref().gamepad_legend then get_menu_ref().gamepad_legend:Show(true) end
end

function on_btn_options_ixr_clicked()
	ixr_options.dynamic_vars.menu_opened = true
	get_menu_ref().ixr_options_btn:Show(false)
	if get_menu_ref().eng_lang_btn then get_menu_ref().eng_lang_btn:Show(false) end
	if get_menu_ref().ru_lang_btn then get_menu_ref().ru_lang_btn:Show(false) end
	if get_menu_ref().shniaga then
		get_menu_ref().shniaga:SetVisibleMagnifier(false)
		get_menu_ref().shniaga:Show(false)
	end
	if get_menu_ref().gamepad_legend then get_menu_ref().gamepad_legend:Show(false) end
	draw_options()
end

function _on_main_menu_init_controlls(_ref)
	set_menu_ref(_ref)
	
	register_static("ixr_options_background", "ixr_options_overlay_background", 0, 0, 1024, 768, GetARGB(255, 255, 255, 255))
	
	local y_padding = 2
	local title_alpha = 225
	local middle_alpha = 120
	local title_text_alpha = 190
	
	register_static("ixr_options_title_bg", "black_texture", 13, 13, 958, 43, GetARGB(title_alpha, 255, 255, 255))
	register_text("ixr_options_title_text", "ixr_options_boycott_32_l", "IX-RAY OPTIONS", 442, 23, 287, 43, GetARGB(title_text_alpha, 255, 255, 255))
	
	register_static("ixr_options_title_close_btn_bg", "black_texture", 971, 13, 43, 43, GetARGB(255, 255, 255, 255))
	register_button("ixr_options_exit_btn", "ixr_options_close_button", 976, 18, 32, 32, this.on_ixr_options_exit_btn_clicked)
	
	register_static("ixr_options_middle_bg", "black_texture", 13, 56, 1001, 654, GetARGB(middle_alpha, 255, 255, 255))
	
	register_static("ixr_options_l_column_title_bg", "black_texture", 33, 83, 250, 600, GetARGB(middle_alpha, 255, 255, 255))
	register_static("ixr_options_l_column_bg", "black_texture", 33, 83, 250, 25, GetARGB(middle_alpha, 255, 255, 255))
	register_text("ixr_options_l_column_title_text", "ixr_options_boycott_18_l", "SCRIPTS", 150, 87, 250, 600, GetARGB(title_text_alpha, 255, 255, 255))
	
	register_static("ixr_options_r_column_title_bg", "black_texture", 308, 83, 685, 25, GetARGB(middle_alpha, 255, 255, 255))
	register_static("ixr_options_r_column_bg", "black_texture", 308, 83, 685, 600, GetARGB(middle_alpha, 255, 255, 255))
	register_text("ixr_options_r_column_title_text", "ixr_options_boycott_18_l", "SCRIPT OPTIONS", 625, 87, 685, 25, GetARGB(title_text_alpha, 255, 255, 255))
	
	register_static("ixr_options_footer_bg", "black_texture", 13, 710, 1001, 43, GetARGB(title_alpha, 255, 255, 255))
	
	--[[
	register_static("ixr_options_r_column_info_bg", "black_texture", 308, 108, 685, 150, GetARGB(middle_alpha - (middle_alpha / 2) , 255, 255, 255))
	
	local immage_padding = 5
	register_image("ixr_options_r_column_info_image", "ui\\ixr_options\\icons\\addon_info_image_none", 308 + immage_padding, 108 + immage_padding, 200 - immage_padding, 150 - (immage_padding * 2), 120)
	
	]]
	
	register_list_box("addons_list_box", "addons_list", 33, 108, 250, 575, 100)
	
	register_button("ixr_save_options", "ixr_product_sans_16_l", 976, 710 + 14, 100, 18, function () _save_options() end)
	get_controll("ixr_save_options"):TextControl():SetText("SAVE")
	get_controll("ixr_save_options"):TextControl():SetTextColor(GetARGB(title_text_alpha, 255, 255, 255))
	
	
	get_controll("addons_list_box"):RemoveAll()
	
	-- наши аддоны всегда с верху
	for options_script_name, options_variables in pairs(getOptions()) do
		if ffx_string_utils.start_with(options_script_name, "ixray_") or ffx_string_utils.start_with(options_script_name, "ixr_") then
			get_controll("addons_list_box"):AddExistingItem(AddonItem(
				vector2():set(250, 65), 
				"ui\\ixr_options\\icons\\ixr_addon_icon",
				tostring(options_script_name).. ".script", GetARGB(255, 122, 255, 122),
				"IXRay Team", GetARGB(255, 150, 150, 150),
				"1.0.0", GetARGB(255, 150, 150, 150),
				"IXRay Addon", GetARGB(255, 150, 150, 150),
				options_variables,
				ixr_options.options_addon_info[options_script_name] or {}
			))
		end
	end
	
	local sorted_addons_names = {}
	-- сборка листа сортировки для именованных аддонов
	for options_script_name, options_variables in pairs(getOptions()) do
		if not (ffx_string_utils.start_with(options_script_name, "ixray_") or ffx_string_utils.start_with(options_script_name, "ixr_")) then
			if ixr_options.options_addon_info[options_script_name] and ixr_options.options_addon_info[options_script_name].options_addon_name ~= nil then
				if not ffx_table_utils.is_contains(sorted_addons_names, ixr_options.options_addon_info[options_script_name].options_addon_name) then
					table.insert(sorted_addons_names, ixr_options.options_addon_info[options_script_name].options_addon_name)
				end
			end
		end
	end
	
	-- сортировка по именованным аддонам
	for i, addon_name in ipairs(sorted_addons_names) do
		for options_script_name, options_variables in pairs(getOptions()) do
			if not (ffx_string_utils.start_with(options_script_name, "ixray_") or ffx_string_utils.start_with(options_script_name, "ixr_")) and ixr_options.options_addon_info[options_script_name] and addon_name == ixr_options.options_addon_info[options_script_name].options_addon_name then
				get_controll("addons_list_box"):AddExistingItem(AddonItem(
					vector2():set(250, 65), 
					"ui\\ixr_options\\icons\\addon_icon",
					tostring(options_script_name).. ".script", GetARGB(255, 255, 255, 255),
					"[Unknown]", GetARGB(255, 150, 150, 150),
					"[Unknown]", GetARGB(255, 150, 150, 150),
					"[Unknown]", GetARGB(255, 150, 150, 150),
					options_variables,
					ixr_options.options_addon_info[options_script_name] or {}
				))
			end
		end
	end
	
	-- сортировка в конец безымянных аддонов
	for options_script_name, options_variables in pairs(getOptions()) do
		if not (ffx_string_utils.start_with(options_script_name, "ixray_") or ffx_string_utils.start_with(options_script_name, "ixr_")) and ((not ixr_options.options_addon_info[options_script_name]) or  ixr_options.options_addon_info[options_script_name].options_addon_name == nil) then
			get_controll("addons_list_box"):AddExistingItem(AddonItem(
				vector2():set(250, 65), 
				"ui\\ixr_options\\icons\\addon_icon",
				tostring(options_script_name).. ".script", GetARGB(255, 255, 255, 255),
				"[Unknown]", GetARGB(255, 150, 150, 150),
				"[Unknown]", GetARGB(255, 150, 150, 150),
				"[Unknown]", GetARGB(255, 150, 150, 150),
				options_variables,
				ixr_options.options_addon_info[options_script_name] or {}
			))
		end
	end
		
	--register_scroll_view("options_scroll", "scroll_v", 320, 270, 670, 400)
	register_scroll_view("options_scroll", "scroll_v", 320, 125, 670, 550) -- (name_controll, scroll_section, x, y, width, height)
	register_framewindow("framewindow_gamepad", "frame_window", 33, 108, 250, 575)
	register_gamepad_legend("gamepad_legend", "gamepad_legend")
	get_controll("options_scroll"):Show(false)
end

function on_draw_options(index, item)
	local ungroupped_controlls = {}
	local groupped_controlls = {}
	local groups_order = {}
	
	for _variable_name, option_data in pairs(item.options_variables) do
		if option_data["group_name"] == nil then
			table.insert(ungroupped_controlls, option_data)
		else
			if groupped_controlls[tostring(option_data["group_name"])] == nil then
				groupped_controlls[tostring(option_data["group_name"])] = {}
				table.insert(groups_order, option_data["group_name"])
			end
			
			table.insert(groupped_controlls[tostring(option_data["group_name"])], option_data)
		end
	end
	
	local padding = 7
	local alpha = 75
	
	-- Чистим данные контролов для геймпада
	on_before_clear_controlls_info_gamepads()
	
	local cnt_ungroupped_controlls = #ungroupped_controlls
	if cnt_ungroupped_controlls > 0 then
		for i=1, cnt_ungroupped_controlls do
			if ungroupped_controlls[i] then
				add_single_ungroupped_option(getNextControllIndex(), padding, alpha + (alpha / 2), ungroupped_controlls[i])
			end
		end
	end
	
	local cnt_groups_order = #groups_order
	if cnt_groups_order > 0 then
		for i=1, cnt_groups_order do
			if groupped_controlls[groups_order[i]] then
				add_option_group(getNextControllIndex(), padding, alpha, math.random(2,6), groupped_controlls[groups_order[i]][1]["group_name"], groupped_controlls[groups_order[i]])
			end
		end
	end
	
	-- Ставим метку о том что генерация контролов завершена теперь доступна их метадата
	on_controlls_rendering_completed()
	
	return true
end

local skip_redraw = false

function ReDraw()
	if skip_redraw then
		return
	end
	
	if ixr_options.is_initialized() and ixr_options.is_options_opened() then
		local listBox = get_controll("addons_list_box")
		if listBox and listBox:GetSize() > 0 and listBox:GetSelectedItem() ~= nil then
			SemiLog("REDRAW OPTIONS IXR")
			---ixr_options.dynamic_vars.is_callbacks_skip = true
			skip_redraw = true
			OnAddonItemClicked()
			skip_redraw = false
			--ixr_options.dynamic_vars.is_callbacks_skip = false
		end
	end
end

function OnAddonItemClicked()
	if get_controll("addons_list_box"):GetSize() == 0 then return end

	local item = get_controll("addons_list_box"):GetSelectedItem()
	local index = get_controll("addons_list_box"):GetSelectedIndex()
	
	--SemiLog("selected:" .. tostring(index) .. " name:" .. tostring(item.addon_display_name))
	
	get_controll("options_scroll"):Clear()
	get_controll("options_scroll"):Show(false)
	if on_draw_options(index, item) then
		get_controll("options_scroll"):Show(true)
	end
end

function pick_controll(option_data, option_bg, option_key_name)
	local controll_type = option_data["controll_data"]["controll"]
	local group_name = option_data["group_name"] or nil
	local variable_name = option_data["variable_name"]
	local script_name = option_data["script_name"]
	local parent_element_width = option_bg:GetWidth()
	
	local __callback_handler = function (value, ctrl, is_value_from_code)
		if is_user_input == nil then
			is_user_input = true
		end
		
		if ixr_options.dynamic_vars.is_callbacks_skip then
			return
		end
		
		--[[
		if controll_type == "combo_box" then
			if not option_data["controll_data"]["list_values"][value]["is_visible"] then
				SemiLog("DISABLED::"..tostring(controll_type) .. tostring(option_key_name) )
				return
			end
		end
		--]]

		ixr_options.set_variable_value(script_name, variable_name, value)
		option_data["controll_data"]["default_value"] = value
		
		--SemiLog("PICK::" ..tostring(controll_type) .. tostring(option_key_name).." [changed]: "..tostring(value) .. " -- " .. tostring(ctrl)) 
		
		if option_data["_callback"] ~= nil then
			if controll_type == "combo_box" then
				option_data["_callback"](group_name, variable_name, option_data["controll_data"]["list_values"][value]["option_return_value"], is_value_from_code)
			else
				option_data["_callback"](group_name, variable_name, value, is_value_from_code)
			end
		end
	end
	
	if controll_type == "check_box" then
		return register_checkbox(
			tostring(controll_type) .. tostring(option_key_name),
			parent_element_width - ixr_options.controlls_defines.check_box_width - 3.5,
			4,
			ixr_options.controlls_defines.check_box_alpha,
			option_data["controll_data"]["default_value"],
			option_bg,
			__callback_handler,
			script_name, 
			variable_name
		)
	end
		
	if controll_type == "text_box" then
		return register_textbox(
			tostring(controll_type) .. tostring(option_key_name),
			parent_element_width - ixr_options.controlls_defines.text_box_width - 3.5,
			4,
			ixr_options.controlls_defines.text_box_alpha,
			option_data["controll_data"]["default_value"],
			option_bg,
			__callback_handler,
			script_name, 
			variable_name
		)
	end
	
	if controll_type == "combo_box" then
		return register_combobox(
			tostring(controll_type) .. tostring(option_key_name),
			parent_element_width - ixr_options.controlls_defines.combo_box_width - 3.5,
			4,
			ixr_options.controlls_defines.combo_box_alpha,
			option_data["controll_data"]["default_value"],
			option_data["controll_data"]["list_values"],
			option_bg,
			__callback_handler,
			script_name, 
			variable_name
		)
	end
	
	if controll_type == "numeric_up_down" then
		return register_numeric_up_down(
			tostring(controll_type) .. tostring(option_key_name),
			parent_element_width - ixr_options.controlls_defines.numeric_up_down_width - 3.5,
			4,
			ixr_options.controlls_defines.numeric_up_down_alpha,
			option_data["controll_data"]["default_value"],
			option_data["controll_data"]["min_value"],
			option_data["controll_data"]["max_value"],
			option_data["controll_data"]["value_offset"],
			option_bg,
			__callback_handler,
			script_name, 
			variable_name
		)
	end
	
	if controll_type == "track_bar" then
		return  register_track_bar(
			tostring(controll_type) .. tostring(option_key_name),
			parent_element_width - ixr_options.controlls_defines.track_bar_width - 3.5,
			4,
			ixr_options.controlls_defines.track_bar_alpha,
			option_data["controll_data"]["default_value"],
			option_data["controll_data"]["min_value"],
			option_data["controll_data"]["max_value"],
			option_data["controll_data"]["value_offset"],
			option_data["controll_data"]["use_ceil"],
			option_bg,
			__callback_handler,
			script_name, 
			variable_name
		)
	end
end

function add_single_ungroupped_option(option_index, padding, alpha, option_data)
	local texture_width = ixr_options.controlls_defines.option_plane_width
	local texture_height = ixr_options.controlls_defines.option_plane_height
	local display_text = option_data["display_text"]
	local variable_name = option_data["variable_name"]
	--[[
		["script_name"] = script_name,
		["group_name"] = group_name,
		["variable_name"] = variable_name,
		["controll_data"] = controll_data,
	--]]
	add_option_shell(option_index, texture_width, texture_height, function (_shell)
		local controll_option_bg_name = "single_option_bg_" .. tostring(option_index)
		local option_bg = get_options_xml():InitStatic("black_option_rounded_rect", _shell)
		option_bg:SetWndPos(vector2():set(padding, padding))
		option_bg:SetWndSize(vector2():set(texture_width - (padding * 2), texture_height - (padding * 2)))
		option_bg:SetTextureColor(GetARGB(alpha, 225, 225, 225))
		get_menu_ref():Register(option_bg, controll_option_bg_name)
		fix_controll_size(option_bg)
		
		local option_bg_selected = get_options_xml():InitStatic("black_option_rounded_rect_selected", _shell)
		option_bg_selected:SetWndPos(vector2():set(padding, padding))
		option_bg_selected:SetWndSize(vector2():set(texture_width - (padding * 2), texture_height - (padding * 2)))
		option_bg_selected:SetTextureColor(GetARGB(alpha, 225, 225, 225))
		option_bg_selected:Show(false)
		get_menu_ref():Register(option_bg_selected, controll_option_bg_name.."_selected")
		fix_controll_size(option_bg_selected)
		
		local option_bg_focused = get_options_xml():InitStatic("black_option_rounded_rect_focused", _shell)
		option_bg_focused:SetWndPos(vector2():set(padding, padding))
		option_bg_focused:SetWndSize(vector2():set(texture_width - (padding * 2), texture_height - (padding * 2)))
		option_bg_focused:SetTextureColor(GetARGB(alpha, 225, 225, 225))
		option_bg_focused:Show(false)
		get_menu_ref():Register(option_bg_focused, controll_option_bg_name.."_focused")
		fix_controll_size(option_bg_focused)
		
		local displayText = "text_" .. tostring(option_index)
		local ctrl_name = "txt_"  .. tostring(option_index)
		
		local CTRLText = get_options_xml():InitStatic("ixr_product_sans_12_l", option_bg)
		CTRLText:SetWndPos(vector2():set(5, 8))
		CTRLText:SetWndSize(vector2():set(250, 25))
		
		if DRAW_VAR_NAME then
			CTRLText:TextControl():SetText( tostring(variable_name) .. " (" .. tostring(game.translate_string(tostring(display_text)) or display_text) .. ")" )
		else
			CTRLText:TextControl():SetText( tostring(game.translate_string(tostring(display_text)) or display_text) )
		end
		
		
		CTRLText:TextControl():SetTextColor(GetARGB(255, 200, 200, 200))
		CTRLText:Show(true)
		get_menu_ref():Register(CTRLText, "ixr_controll_label_"  .. tostring(option_index))
		
		local controll_ref = pick_controll(option_data, option_bg, tostring(option_index))

		local _metadata = ixr_options.get_metadata(option_data["script_name"], option_data["variable_name"])
		_metadata.controll_type = option_data["controll_data"]["controll"]
		_metadata.controll_ref = controll_ref
		_metadata.script_name = option_data["script_name"]
		_metadata.variable_name = option_data["variable_name"]
		_metadata.background_focused_controll_ref = option_bg_focused
		_metadata.background_selected_controll_ref = option_bg_selected
		_metadata.background_controll_ref = option_bg
		_metadata.background_controll_color = GetARGB(alpha, 225, 225, 225)
		_metadata.label_controll_ref = CTRLText
		_metadata.label_controll_color = GetARGB(255, 200, 200, 200)
		ixr_options.set_metadata(option_data["script_name"], option_data["variable_name"], _metadata)
		
		register_controll_metadata_for_gamepad(option_data["script_name"], option_data["variable_name"], _metadata)
	end)

end

function add_option_group(option_index, padding, alpha, count, group_display_text, group_options)
	local controll_group_option_bg_name = "groupp_option_bg_" .. tostring(option_index)
	local controll_option_bg_name = "groupped_option_bg_" .. tostring(option_index)
	local texture_width = ixr_options.controlls_defines.option_plane_width
	local texture_height = ixr_options.controlls_defines.option_plane_height
	local shell = add_option_shell(option_index, texture_width, texture_height)
	
	local before_y_offset = padding
	local after_y_offset = padding + padding + padding
	local group_bg = get_options_xml():InitStatic("black_texture", shell)
	group_bg:SetWndPos(vector2():set(0, before_y_offset))
	group_bg:SetWndSize(vector2():set(1, 1))
	group_bg:SetTextureColor(GetARGB(alpha, 225, 225, 225))
	get_menu_ref():Register(group_bg, controll_group_option_bg_name)
	
	local group_name_text_height = 25
	local group_name_controll = get_options_xml():InitStatic("ixr_product_sans_16_l", group_bg)
	group_name_controll:SetWndPos(vector2():set(padding, before_y_offset + padding))
	group_name_controll:SetWndSize(vector2():set(texture_width - padding, group_name_text_height))
	group_name_controll:TextControl():SetText(tostring(game.translate_string(tostring(group_display_text)) or group_display_text))
	group_name_controll:TextControl():SetTextColor(GetARGB(255, 200, 200, 200))
	group_name_controll:Show(true)
	get_menu_ref():Register(group_name_controll, "ixr_group_controll_label_"  .. tostring(option_index))
	
	local sum_height = 0
	local y_offset = group_name_text_height + padding
	for k, option_data in pairs(group_options) do
		local display_text = option_data["display_text"]
		local variable_name = option_data["variable_name"]
		
		local option_bg = get_options_xml():InitStatic("black_option_rounded_rect", group_bg)
		option_bg:SetWndPos(vector2():set(padding, padding + y_offset))
		option_bg:SetWndSize(vector2():set(texture_width - (padding * 2), texture_height - (padding * 2)))
		option_bg:SetTextureColor(GetARGB(alpha, 225, 225, 225))
		get_menu_ref():Register(option_bg, controll_option_bg_name .. "_" .. tostring(i))
		fix_controll_size(option_bg)
		
		local option_bg_selected = get_options_xml():InitStatic("black_option_rounded_rect_selected", group_bg)
		option_bg_selected:SetWndPos(vector2():set(padding, padding + y_offset))
		option_bg_selected:SetWndSize(vector2():set(texture_width - (padding * 2), texture_height - (padding * 2)))
		option_bg_selected:SetTextureColor(GetARGB(alpha, 225, 225, 225))
		option_bg_selected:Show(false)
		get_menu_ref():Register(option_bg_selected, controll_option_bg_name .. "_selected_" .. tostring(i))
		fix_controll_size(option_bg_selected)
		
		local option_bg_focused = get_options_xml():InitStatic("black_option_rounded_rect_focused", group_bg)
		option_bg_focused:SetWndPos(vector2():set(padding, padding + y_offset))
		option_bg_focused:SetWndSize(vector2():set(texture_width - (padding * 2), texture_height - (padding * 2)))
		option_bg_focused:SetTextureColor(GetARGB(alpha, 225, 225, 225))
		option_bg_focused:Show(false)
		get_menu_ref():Register(option_bg_focused, controll_option_bg_name .. "_focused_" .. tostring(i))
		fix_controll_size(option_bg_focused)
		
		local option_name_controll = get_options_xml():InitStatic("ixr_product_sans_12_l", option_bg)
		option_name_controll:SetWndPos(vector2():set(padding, padding))
		option_name_controll:SetWndSize(vector2():set(texture_width - padding, group_name_text_height))
		
		if DRAW_VAR_NAME then
			option_name_controll:TextControl():SetText( tostring(variable_name) .. " (" .. tostring(game.translate_string(tostring(display_text)) or display_text) .. ")" )
		else
			option_name_controll:TextControl():SetText( tostring(game.translate_string(tostring(display_text)) or display_text) )
		end
		
		option_name_controll:TextControl():SetTextColor(GetARGB(255, 200, 200, 200))
		option_name_controll:Show(true)
		get_menu_ref():Register(option_name_controll, "ixr_option_name_label_"  .. tostring(option_index) .. "_" .. tostring(i))
		
		local controll_ref = pick_controll(option_data, option_bg, tostring(option_index) .. "_" .. tostring(i))
		local _metadata = ixr_options.get_metadata(option_data["script_name"], option_data["variable_name"])
		_metadata.controll_type = option_data["controll_data"]["controll"]
		_metadata.controll_ref = controll_ref
		_metadata.script_name = option_data["script_name"]
		_metadata.variable_name = option_data["variable_name"]
		_metadata.background_focused_controll_ref = option_bg_focused
		_metadata.background_selected_controll_ref = option_bg_selected
		_metadata.background_controll_ref = option_bg
		_metadata.background_controll_color = GetARGB(alpha, 225, 225, 225)
		_metadata.label_controll_ref = option_name_controll
		_metadata.label_controll_color = GetARGB(255, 200, 200, 200)
		ixr_options.set_metadata(option_data["script_name"], option_data["variable_name"], _metadata)

		register_controll_metadata_for_gamepad(option_data["script_name"], option_data["variable_name"], _metadata)
		
		y_offset = y_offset + option_bg:GetHeight() + padding
		sum_height = sum_height + option_bg:GetHeight() + padding
	end
	
	local last_height = shell:GetHeight()
	shell:SetWndSize(vector2():set(texture_width + padding, before_y_offset + y_offset + after_y_offset))
	group_bg:SetWndSize(vector2():set(texture_width + padding, y_offset + padding + padding))
end

function add_option_shell(shell_index, width, height, fn_fillable)
	local controll_shell_name = "option_shell_" .. tostring(shell_index)
	local shell = get_options_xml():InitStatic("black_texture", nil)
	shell:SetWndPos(vector2():set(0, 0))
	shell:SetWndSize(vector2():set(width, height))
	shell:SetTextureColor(GetARGB(0, 225, 225, 225))
	get_menu_ref():Register(shell, controll_shell_name)
	
	if fn_fillable ~= nil then
		fn_fillable(shell)
	end
	
	local scroll_v = get_controll("options_scroll")
	scroll_v:AddWindow(shell, false)
	scroll_v:SetAutoDelete(false)
	
	return shell
end


-- #########################################################################################################
-- 												TRACK BAR
-- #########################################################################################################
class "IXRTrackBar" (CUIStatic)
function IXRTrackBar:__init(controll_name, x, y, alpha, default_value, min_value, max_value, value_offset, use_ceil, _callback, _ref, script_name, variable_name)
	super()
	
	self.script_visible_controlls = nil
	self.script_visible_background = nil
	self.script_gray_label = nil
	self.script_gray_background = nil
	
	self.is_pushed_from_code = false
	self.script_name = script_name
	self.variable_name = variable_name
	
	self.use_ceil = use_ceil
	self.visible = false
	self.value = 0.0
	self.value_offset = value_offset
	self.min_value = min_value
	self.max_value = max_value
	
	self.on_change_callback = _callback
	self.controll_name = controll_name .. "_" .. tostring(getNextControllIndex())
	
	local w = ixr_options.controlls_defines.track_bar_width
	local h = ixr_options.controlls_defines.track_bar_height
	
	self:SetWndSize(vector2():set(x, y))
	self:SetWndPos(vector2():set(w, h))
	
	self.controll_background = get_options_xml():InitStatic("black_option_rounded_rect", _ref)
	self.controll_background:SetWndPos(vector2():set(x, y))
	self.controll_background:SetWndSize(vector2():set(w, h))
	self.controll_background:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_background:SetStretchTexture(true)
	self.controll_background:Show(false)
	
	self.controll_text = get_options_xml():InitStatic("text_box_middle", self.controll_background)
	self.controll_text:SetWndPos(vector2():set(3, 2))
	self.controll_text:SetWndSize(vector2():set(50, 16))
	self.controll_text:Show(false)
	if self.use_ceil then
		self.controll_text:TextControl():SetText("0")
	else
		self.controll_text:TextControl():SetText("0.0")
	end
	self.controll_text:TextControl():SetTextColor(GetARGB(200, 255, 255, 255))
	
	self.controll_track_bar = get_options_xml():InitTrackBar("track_bar", self.controll_background)
	self.controll_track_bar:SetWndPos(vector2():set(50 + 4, 2))
	self.controll_track_bar:SetWndSize(vector2():set(w - 60, h))
	self.controll_track_bar:SetOptFBounds(self.min_value, self.max_value)
	self.controll_track_bar:SetStep(self.value_offset)
	self.controll_track_bar:Show(false)
	
	self:SetValue(default_value)
end

function IXRTrackBar:Show(flag, skip_callbacks)
	if skip_callbacks == nil then 
		skip_callbacks = false
	end
	
	self.visible = flag
	self.controll_background:Show(flag)
	self.controll_track_bar:Show(flag)
	self.controll_text:Show(flag)
	
	if not skip_callbacks then
		if flag then
			self:OnChangeState()
			set_main_menu_update(self.controll_name.."track_bar", function () self:Update() end)
		else
			set_main_menu_update(self.controll_name.."track_bar", nil)
		end
	end
end

function IXRTrackBar:Update()
	if self.controll_track_bar:GetFValue() ~= self.value then
		self.value = self.controll_track_bar:GetFValue()
		self:OnChangeState()
	end
	
	local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)
	self:UpdateVisualValue(metadata)
	self:UpdateControllVisibility(metadata)
end

--[[
metadata.background_controll_ref = option_bg
metadata.background_controll_color =  GetARGB(alpha, 225, 225, 225)
metadata.label_controll_ref = CTRLText
metadata.label_controll_color = GetARGB(255, 200, 200, 200)

metadata.visible_controlls
metadata.visible_background
metadata.gray_label
metadata.gray_background
--]]

function IXRTrackBar:UpdateControllVisibility(metadata)
	if metadata ~= nil and self.script_visible_controlls ~= metadata.visible_controlls then
		self.script_visible_controlls = metadata.visible_controlls
		self:Show(metadata.visible_controlls, true)
	end
	
	if metadata ~= nil and self.script_visible_background ~= metadata.visible_background then
		self.script_visible_background = metadata.visible_background
		if metadata.script_visible_background ~= nil then
			metadata.background_controll_ref:Show(metadata.visible_background)
		end
	end
	
	if metadata ~= nil and self.script_visible_background ~= metadata.gray_label then
		self.script_gray_label = metadata.gray_label
		if metadata.label_controll_ref ~= nil then
			if metadata.gray_label then
				metadata.label_controll_ref:TextControl():SetTextColor(GetARGB(255, 100, 100, 100))
			else
				metadata.label_controll_ref:TextControl():SetTextColor(metadata.label_controll_color)
			end
		end
	end
	
	if metadata ~= nil and self.script_visible_background ~= metadata.gray_background then
		self.script_gray_background = metadata.gray_background
		if metadata.background_controll_ref ~= nil then
			if metadata.gray_background then
				metadata.background_controll_ref:SetTextureColor(GetARGB(50, 225, 225, 225))
			else
				metadata.background_controll_ref:SetTextureColor(metadata.background_controll_color)
			end
		end
	end
end


function IXRTrackBar:UpdateVisualValue(metadata)
	if metadata ~= nil and metadata.update_visual_value ~= nil then
		local new_value = metadata.update_visual_value
		metadata.update_visual_value = nil
		ixr_options.set_metadata(self.script_name, self.variable_name, metadata)
		on_apply_new_metadata_value(self.script_name, self.variable_name, new_value, self)
		
		self:OnIncomingUpdateVisualValue(new_value)
		self.value = self.controll_track_bar:GetFValue()
	end
end

function IXRTrackBar:OnIncomingUpdateVisualValue(new_value_index)
	if self.value == new_value_index then
		return
	end
	
	self.is_pushed_from_code = true
	self:SetValue(new_value_index)
end

function IXRTrackBar:OnChangeState()
	if self.value ~= nil then
		if self.use_ceil then
			self.controll_text:TextControl():SetText(tostring(math.ceil(self.value)))
		else
			self.controll_text:TextControl():SetText(tostring(string.format("%.3f", self.value)))
		end
	else
		if self.use_ceil then
			self.controll_text:TextControl():SetText("0")
		else
			self.controll_text:TextControl():SetText("0.0")
		end
	end
	
	if self.visible and self.on_change_callback then
		if self.use_ceil then
			self.on_change_callback(math.ceil(self:GetValue()), self.controll_name, self.is_pushed_from_code)
		else
			self.on_change_callback(self:GetValue(), self.controll_name, self.is_pushed_from_code)
		end
	end
	self.is_pushed_from_code = false
end

function IXRTrackBar:SetValue(value)
	if value < self.min_value then
		value = self.min_value
	end
	
	if value > self.max_value then
		value = self.max_value
	end

	if self.value ~= value then
		self.value = value
		self.controll_track_bar:SetFValue(self.value)
		self:OnChangeState()
	end
end

function IXRTrackBar:GetValue()
	return self.value or 0
end

-- for game pad events
function IXRTrackBar:on_gamepad_left(is_hold)
	self:SetValue(self:GetValue() - self.value_offset)
end

-- for game pad events
function IXRTrackBar:on_gamepad_right(is_hold)
	self:SetValue(self:GetValue() + self.value_offset)
end

-- #########################################################################################################
-- 											NUMERIC UP DOWN
-- #########################################################################################################
class "IXRNumericUpDown" (CUIStatic)
function IXRNumericUpDown:__init(controll_name, x, y, alpha, default_value, min_value, max_value, value_offset, _callback, _ref, script_name, variable_name)
	super()
	
	self.is_pushed_from_code = false
	self.script_name = script_name
	self.variable_name = variable_name
	
	self.visible = false
	self.value = 0.0
	self.value_offset = value_offset
	self.min_value = min_value
	self.max_value = max_value
	
	self.on_change_callback = _callback
	self.controll_name = controll_name .. "_" .. tostring(getNextControllIndex())
	
	local w = ixr_options.controlls_defines.numeric_up_down_width
	local h = ixr_options.controlls_defines.numeric_up_down_height
	
	self:SetWndSize(vector2():set(x, y))
	self:SetWndPos(vector2():set(w, h))
	
	self.controll_background = get_options_xml():InitStatic("black_option_rounded_rect", _ref)
	self.controll_background:SetWndPos(vector2():set(x, y))
	self.controll_background:SetWndSize(vector2():set(w, h))
	self.controll_background:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_background:SetStretchTexture(true)
	self.controll_background:Show(false)
	
	local arrow_size = 16
	
	self.controll_arrow_left = get_options_xml():Init3tButton("combo_box_left_arrow", self.controll_background)
	self.controll_arrow_left:SetWndPos(vector2():set(1, 1))
	self.controll_arrow_left:SetWndSize(vector2():set(arrow_size, arrow_size))
	self.controll_arrow_left:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_arrow_left:SetStretchTexture(true)
	self.controll_arrow_left:Show(false)
	get_menu_ref():Register(self.controll_arrow_left, self.controll_name .. "_left_arrow_btn")
	get_menu_ref():AddCallback(self.controll_name .. "_left_arrow_btn", ui_events.BUTTON_CLICKED, function () self:LeftArrowClick() end, get_menu_ref())
	
	self.controll_arrow_right = get_options_xml():Init3tButton("combo_box_right_arrow", self.controll_background)
	self.controll_arrow_right:SetWndPos(vector2():set(self.controll_background:GetWidth() - (arrow_size + 1), 1))
	self.controll_arrow_right:SetWndSize(vector2():set(arrow_size, arrow_size))
	self.controll_arrow_right:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_arrow_right:SetStretchTexture(true)
	self.controll_arrow_right:Show(false)
	get_menu_ref():Register(self.controll_arrow_right, self.controll_name .. "_right_arrow_btn")
	get_menu_ref():AddCallback(self.controll_name .. "_right_arrow_btn", ui_events.BUTTON_CLICKED, function () self:RightArrowClick() end, get_menu_ref())
	
	self.controll_text = get_options_xml():InitStatic("text_box_middle", self.controll_background)
	self.controll_text:SetWndPos(vector2():set(arrow_size + 3, 1))
	self.controll_text:SetWndSize(vector2():set(self.controll_background:GetWidth() - ((arrow_size * 2) + 6), arrow_size))
	self.controll_text:Show(false)
	self.controll_text:TextControl():SetText("0.0")
	self.controll_text:TextControl():SetTextColor(GetARGB(200, 255, 255, 255))
	
	self:SetValue(default_value)
end

function IXRNumericUpDown:Show(flag)
	self.visible = flag
	self.controll_background:Show(flag)
	self.controll_arrow_left:Show(flag)
	self.controll_arrow_right:Show(flag)
	self.controll_text:Show(flag)
	
	if flag then
		self:OnChangeState()
		set_main_menu_update(self.controll_name.."numeric_up_down", function () self:Update() end)
	else
		set_main_menu_update(self.controll_name.."numeric_up_down", nil)
	end
	
	self:UpdateArrowsVisibility()
end

function IXRNumericUpDown:Update()
	self:UpdateVisualValue()
end

-- update_visual_value
function IXRNumericUpDown:UpdateVisualValue()
	local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)
	if metadata ~= nil and metadata.update_visual_value ~= nil then
		local new_value = metadata.update_visual_value
		metadata.update_visual_value = nil
		ixr_options.set_metadata(self.script_name, self.variable_name, metadata)
		on_apply_new_metadata_value(self.script_name, self.variable_name, new_value, self)
		self:OnIncomingUpdateVisualValue(new_value)
	end
end

function IXRNumericUpDown:OnIncomingUpdateVisualValue(new_value)
	if self.value == new_value then
		return
	end
	self.is_pushed_from_code = true
	self:SetValue(new_value)
end

function IXRNumericUpDown:UpdateArrowsVisibility()
	if not self.visible then
		return
	end
	
	if self.value == self.min_value then
		self.controll_arrow_left:Show(false)
		self.controll_arrow_right:Show(true)
		return
	end
	
	if self.value == self.max_value then
		self.controll_arrow_left:Show(true)
		self.controll_arrow_right:Show(false)
		return
	end
	
	self.controll_arrow_left:Show(true)
	self.controll_arrow_right:Show(true)
end

function IXRNumericUpDown:LeftArrowClick()
	self:SetValue(self.value - self.value_offset)
end

function IXRNumericUpDown:RightArrowClick()
	self:SetValue(self.value + self.value_offset)
end

function IXRNumericUpDown:SetValue(new_value)
	self.value = new_value
	
	if self.value < self.min_value then
		self.value = self.min_value
	end
	
	if self.value > self.max_value then
		self.value = self.max_value
	end
	
	self.controll_text:TextControl():SetText(tostring(self.value))

	self:UpdateArrowsVisibility()
	self:OnChangeState()
end

function IXRNumericUpDown:GetValue()
	return self.value
end

function IXRNumericUpDown:OnChangeState()
	if self.on_change_callback then
		self.on_change_callback(self:GetValue(), self.controll_name, self.is_pushed_from_code)
	end
	self.is_pushed_from_code = false
end

-- for game pad events
function IXRNumericUpDown:on_gamepad_left(is_hold)
	self:LeftArrowClick()
end

-- for game pad events
function IXRNumericUpDown:on_gamepad_right(is_hold)
	self:RightArrowClick()
end

-- #########################################################################################################
-- 											COMBO BOX
-- #########################################################################################################
class "IXRComboBox" (CUIStatic)
function IXRComboBox:__init(controll_name, x, y, alpha, default_value_index, list_values, _callback, _ref, script_name, variable_name)
	super()
	
	self.visible = false
	self.value_index = nil
	self.list_values = list_values
	
	self.is_pushed_from_code = false
	self.script_name = script_name
	self.variable_name = variable_name
	self.disabled_ids = {}
	self:RefreshDisabledIds()
	
	
	self.on_change_callback = _callback
	self.controll_name = controll_name .. "_" .. tostring(getNextControllIndex())
	
	local w = ixr_options.controlls_defines.combo_box_width
	local h = ixr_options.controlls_defines.combo_box_height
	
	self:SetWndSize(vector2():set(x, y))
	self:SetWndPos(vector2():set(w, h))
	
	self.controll_background = get_options_xml():InitStatic("black_option_rounded_rect", _ref)
	self.controll_background:SetWndPos(vector2():set(x, y))
	self.controll_background:SetWndSize(vector2():set(w, h))
	self.controll_background:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_background:SetStretchTexture(true)
	self.controll_background:Show(false)
	
	local arrow_size = 16
	
	self.controll_arrow_left = get_options_xml():Init3tButton("combo_box_left_arrow", self.controll_background)
	self.controll_arrow_left:SetWndPos(vector2():set(1, 1))
	self.controll_arrow_left:SetWndSize(vector2():set(arrow_size, arrow_size))
	self.controll_arrow_left:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_arrow_left:SetStretchTexture(true)
	self.controll_arrow_left:Show(false)
	get_menu_ref():Register(self.controll_arrow_left, self.controll_name .. "_left_arrow_btn")
	get_menu_ref():AddCallback(self.controll_name .. "_left_arrow_btn", ui_events.BUTTON_CLICKED, function () self:LeftArrowClick() end, get_menu_ref())
	
	self.controll_arrow_right = get_options_xml():Init3tButton("combo_box_right_arrow", self.controll_background)
	self.controll_arrow_right:SetWndPos(vector2():set(self.controll_background:GetWidth() - (arrow_size + 1), 1))
	self.controll_arrow_right:SetWndSize(vector2():set(arrow_size, arrow_size))
	self.controll_arrow_right:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_arrow_right:SetStretchTexture(true)
	self.controll_arrow_right:Show(false)
	get_menu_ref():Register(self.controll_arrow_right, self.controll_name .. "_right_arrow_btn")
	get_menu_ref():AddCallback(self.controll_name .. "_right_arrow_btn", ui_events.BUTTON_CLICKED, function () self:RightArrowClick() end, get_menu_ref())
	
	self.controll_text = get_options_xml():InitStatic("text_box_middle", self.controll_background)
	self.controll_text:SetWndPos(vector2():set(arrow_size + 3, 1))
	self.controll_text:SetWndSize(vector2():set(self.controll_background:GetWidth() - ((arrow_size * 2) + 6), arrow_size))
	self.controll_text:Show(false)
	self.controll_text:TextControl():SetText("---")
	self.controll_text:TextControl():SetTextColor(GetARGB(200, 255, 255, 255))
	
	self:SetValueIndex(default_value_index)
end

function IXRComboBox:UpdateTextColor()
	if self:IsIndexDisabled(self.value_index) then
		self.controll_text:TextControl():SetTextColor(GetARGB(200, 150, 100, 100))
	else
		self.controll_text:TextControl():SetTextColor(GetARGB(200, 255, 255, 255))
	end
end

function IXRComboBox:RefreshDisabledIds()
	local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)
	local disabled_ids = {}
	if metadata ~= nil and metadata.disabled_ids ~= nil then
		self.disabled_ids = metadata.disabled_ids
	end
end

-- update_visual_value
function IXRComboBox:UpdateVisualValue()
	local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)
	if metadata ~= nil and metadata.update_visual_value ~= nil then
		local new_value = metadata.update_visual_value
		metadata.update_visual_value = nil
		ixr_options.set_metadata(self.script_name, self.variable_name, metadata)
		on_apply_new_metadata_value(self.script_name, self.variable_name, new_value, self)
		self:OnIncomingUpdateVisualValue(new_value)
	end
end

function IXRComboBox:OnIncomingUpdateVisualValue(new_value_index)
	if self.value_index == new_value_index then
		return
	end
	
	self.is_pushed_from_code = true
	self:SetValueIndex(new_value_index)
end

function IXRComboBox:Update()
	self:RefreshDisabledIds()
	self:UpdateVisualValue()
	self:UpdateTextColor()
end

function IXRComboBox:Show(flag)
	self.visible = flag
	self.controll_background:Show(flag)
	self.controll_arrow_left:Show(flag)
	self.controll_arrow_right:Show(flag)
	self.controll_text:Show(flag)
	
	if flag then
		self:OnChangeState()
	end
	
	self:UpdateArrowsVisibility()
	
	if flag then
		set_main_menu_update(self.controll_name.."combo_box", function () self:Update() end)
	else
		set_main_menu_update(self.controll_name.."combo_box", nil)
	end
end

function IXRComboBox:UpdateArrowsVisibility()
	if not self.visible then
		return
	end
	
	if #self.list_values == 0 then
		self.controll_arrow_left:Show(false)
		self.controll_arrow_right:Show(false)
		return
	end
	
	if self.value_index == 1 then
		self.controll_arrow_left:Show(false)
		self.controll_arrow_right:Show(true)
		return
	end
	
	if self.value_index == #self.list_values then
		self.controll_arrow_left:Show(true)
		self.controll_arrow_right:Show(false)
		return
	end
	
	self.controll_arrow_left:Show(true)
	self.controll_arrow_right:Show(true)
end

function IXRComboBox:LeftArrowClick()
	local allowed_indexes = self:GetAllowedIndexes()
	
	local next_index = self.value_index
	if #allowed_indexes > 0 then
		for i = #allowed_indexes, 1, -1 do
			if allowed_indexes[i] < self.value_index then
				next_index = allowed_indexes[i]
				break
			end
		end
	end

	if next_index == self.value_index then
		self:SetValueIndex(self.value_index - 1)
	else
		self:SetValueIndex(next_index)
	end
end

function IXRComboBox:RightArrowClick()
	local allowed_indexes = self:GetAllowedIndexes()
	
	local next_index = self.value_index
	if #allowed_indexes > 0 then
		for i, v in ipairs(allowed_indexes) do
			if v > self.value_index then
				next_index = v
				break
			end
		end
	end

	if next_index == self.value_index then
		self:SetValueIndex(self.value_index - 1)
	else
		self:SetValueIndex(next_index)
	end
end

function IXRComboBox:SetValueIndex(index)
	if #self.list_values == 0 then
		return
	end
	
	if index < 1 then
		index = 1
	end
	
	if index > #self.list_values then
		index = #self.list_values
	end
	
	self.value_index = index
	
	if #self.list_values > 0 and self.list_values[index] then
		self:UpdateTextColor()
		local display_text = tostring(self.list_values[index]["option_display_name"] or "nil")
		self.controll_text:TextControl():SetText(game.translate_string(display_text) or display_text)
	end

	self:UpdateArrowsVisibility()
	self:OnChangeState()
end

function IXRComboBox:IsIndexDisabled(item_index)
	if #self.disabled_ids <= 0 then
		return false
	end
	
	for k, v in pairs(self.disabled_ids) do
		if item_index == v then
			return true
		end
	end
	
	return false
end

function IXRComboBox:GetAllowedIndexes()	
	local indexes = {}
	for i, v in ipairs(self.list_values) do
		if not self:IsIndexDisabled(i) then
			table.insert(indexes, i)
		end
	end

	return indexes
end

function IXRComboBox:GetValue()
	return self.value_index
end

function IXRComboBox:OnChangeState()
	if self.on_change_callback and not self:IsIndexDisabled(self.value_index) then
		self.on_change_callback(self:GetValue(), self.controll_name, self.is_pushed_from_code)
	end
	self.is_pushed_from_code = false
end

-- for game pad events
function IXRComboBox:on_gamepad_left(is_hold)
	self:LeftArrowClick()
end

-- for game pad events
function IXRComboBox:on_gamepad_right(is_hold)
	self:RightArrowClick()
end

-- #########################################################################################################
-- 												TEXT BOX
-- #########################################################################################################
class "IXRTextBox" (CUIStatic)
function IXRTextBox:__init(controll_name, x, y, alpha, default_value, _callback, _ref, script_name, variable_name)
	super()
	
	self.is_pushed_from_code = false
	self.script_name = script_name
	self.variable_name = variable_name
	
	self.value = nil
	self.on_change_callback = _callback
	self.controll_name = controll_name .. "_" .. tostring(getNextControllIndex())
	
	local w = ixr_options.controlls_defines.text_box_width
	local h = ixr_options.controlls_defines.text_box_height
	
	self:SetWndSize(vector2():set(x, y))
	self:SetWndPos(vector2():set(w, h))
	
	self.controll_background = get_options_xml():InitStatic("black_option_rounded_rect", _ref)
	self.controll_background:SetWndPos(vector2():set(x, y))
	self.controll_background:SetWndSize(vector2():set(w, h))
	self.controll_background:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.controll_background:SetStretchTexture(true)
	self.controll_background:Show(false)
	
	self.edit_box = get_options_xml():InitEditBox("text_box", _ref)
	self.edit_box:SetWndPos(vector2():set(x, y))
	self.edit_box:SetWndSize(vector2():set(w, h))
	self.edit_box:Show(false)
	
	self:SetValue(default_value)
end

-- update_visual_value
function IXRTextBox:UpdateVisualValue()
	local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)
	if metadata ~= nil and metadata.update_visual_value ~= nil then
		local new_value = metadata.update_visual_value
		metadata.update_visual_value = nil
		ixr_options.set_metadata(self.script_name, self.variable_name, metadata)
		on_apply_new_metadata_value(self.script_name, self.variable_name, new_value, self)
		self:OnIncomingUpdateVisualValue(new_value)
	end
end

function IXRTextBox:OnIncomingUpdateVisualValue(new_value)
	if self:GetValue() == new_value then
		return
	end
	
	self.is_pushed_from_code = true
	self:SetValue(new_value)
end

function IXRTextBox:Update()
	if self.edit_box:GetText() ~= self.value then
		self:OnChangeState()
	end
	
	self:UpdateVisualValue()
end

function IXRTextBox:Show(flag)
	self.controll_background:Show(flag)
	self.edit_box:Show(flag)
	
	if flag then
		self:OnChangeState()
	end
	
	if flag then
		set_main_menu_update(self.controll_name.."text_box", function () self:Update() end)
	else
		set_main_menu_update(self.controll_name.."text_box", nil)
	end
end

function IXRTextBox:OnChangeState()
	if self.on_change_callback then
		self.on_change_callback(self:GetValue(), self.controll_name, self.is_pushed_from_code)
	end
	self.is_pushed_from_code = false
end

function IXRTextBox:SetValue(value)
	self.value = value
	self.edit_box:SetText(self.value)
	self:OnChangeState()
end

function IXRTextBox:GetValue()
	self.value = self.edit_box:GetText()

	return self.value
end

-- for game pad events
function IXRTextBox:on_gamepad_left(is_hold)
end

-- for game pad events
function IXRTextBox:on_gamepad_right(is_hold)
end

-- #########################################################################################################
-- 												CHECK BOX
-- #########################################################################################################
class "IXRCheckBox" (CUIStatic)
function IXRCheckBox:__init(check_box_ctrl_name, x, y, alpha, state, _callback, _ref, script_name, variable_name)
	super()
	
	self.is_pushed_from_code = false
	self.script_name = script_name
	self.variable_name = variable_name
	
	self.is_checked = state
	self.on_change_callback = _callback
	self.check_box_ctrl_name = check_box_ctrl_name .. "_" .. tostring(getNextControllIndex())
	
	local w = ixr_options.controlls_defines.check_box_width
	local h = ixr_options.controlls_defines.check_box_height
	
	self:SetWndSize(vector2():set(x, y))
	self:SetWndPos(vector2():set(w, h))
	
	self.check_box_background = get_options_xml():InitStatic("check_box_background", _ref)
	self.check_box_background:SetWndPos(vector2():set(x, y))
	self.check_box_background:SetWndSize(vector2():set(w, h))
	self.check_box_background:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.check_box_background:SetStretchTexture(true)
	self.check_box_background:Show(false)
	
	self.check_box_on = get_options_xml():Init3tButton("check_box_on", _ref)
	self.check_box_on:SetWndPos(vector2():set(x, y))
	self.check_box_on:SetWndSize(vector2():set(w, h))
	self.check_box_on:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.check_box_on:SetStretchTexture(true)
	self.check_box_on:Show(false)
	
	self.check_box_off = get_options_xml():Init3tButton("check_box_off", _ref)
	self.check_box_off:SetWndPos(vector2():set(x, y))
	self.check_box_off:SetWndSize(vector2():set(w, h))
	self.check_box_off:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.check_box_off:SetStretchTexture(true)
	self.check_box_off:Show(false)
	
	get_menu_ref():Register(self.check_box_off, self.check_box_ctrl_name .. "_check_box_off")
	get_menu_ref():AddCallback(self.check_box_ctrl_name .. "_check_box_off", ui_events.BUTTON_CLICKED, function () self:SwitchState() end, get_menu_ref())
	
	get_menu_ref():Register(self.check_box_on, self.check_box_ctrl_name .. "_check_box_on")
	get_menu_ref():AddCallback(self.check_box_ctrl_name .. "_check_box_on", ui_events.BUTTON_CLICKED, function () self:SwitchState() end, get_menu_ref())
end

function IXRCheckBox:Show(flag)
	self.check_box_background:Show(flag)
	self.check_box_on:Show(flag)
	self.check_box_off:Show(flag)
	
	if flag then
		self:OnChangeState()
	end
	
	if flag then
		set_main_menu_update(self.check_box_ctrl_name.."check_box", function () self:Update() end)
	else
		set_main_menu_update(self.check_box_ctrl_name.."check_box", nil)
	end
end

function IXRCheckBox:Update()
	self:UpdateVisualValue()
end

-- update_visual_value
function IXRCheckBox:UpdateVisualValue()
	local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)
	if metadata ~= nil and metadata.update_visual_value ~= nil then
		local new_value = metadata.update_visual_value
		metadata.update_visual_value = nil
		ixr_options.set_metadata(self.script_name, self.variable_name, metadata)
		on_apply_new_metadata_value(self.script_name, self.variable_name, new_value, self)
		self:OnIncomingUpdateVisualValue(new_value)
	end
end

function IXRCheckBox:OnIncomingUpdateVisualValue(new_state)
	if self:IsChecked() == new_state then
		return
	end
	self.is_pushed_from_code = true
	self:SetState(new_state)
end

function IXRCheckBox:SwitchState()
	self:SetState(not self:IsChecked())
end

function IXRCheckBox:OnChangeState()
	self.check_box_on:Show(false)
	self.check_box_off:Show(false)
	
	if self:IsChecked() then
		self.check_box_on:Show(true)
	else
		self.check_box_off:Show(true)
	end
	
	if self.on_change_callback then
		self.on_change_callback(self:IsChecked(), self.check_box_ctrl_name, self.is_pushed_from_code)
	end
	self.is_pushed_from_code = false
end

function IXRCheckBox:SetState(state)
	self.is_checked = state
	self:OnChangeState()
end

function IXRCheckBox:IsChecked()
	return self.is_checked
end

-- for game pad events
function IXRCheckBox:on_gamepad_left(is_hold)
	self:SetState(false)
end

-- for game pad events
function IXRCheckBox:on_gamepad_right(is_hold)
	self:SetState(true)
end

-- #########################################################################################################
-- 												ADDON ITEM
-- #########################################################################################################
class "AddonItem" (CUIListBoxItem)

function AddonItem:__init(wnd_size, icon_path, script_name, color_option_title, addon_authors, color_platform, addon_version, color_version, addon_name, color_status, options_variables, addon_info) super()
	self.addon_info = addon_info
	
	self.option_title = game.translate_string(self.addon_info.options_title) or self.addon_info.options_title
	self.icon_path = icon_path
	
	if self.addon_info.icon_path ~= nil then
		self.icon_path = self.addon_info.icon_path
	end
	
	self.options_addon_name = addon_name
	if self.addon_info.options_addon_name ~= nil then
		self.options_addon_name =  game.translate_string(tostring(self.addon_info.options_addon_name)) or tostring(self.addon_info.options_addon_name)
	end
	
	self.options_script_version = addon_version
	if self.addon_info.options_script_version ~= nil then
		self.options_script_version = tostring(self.addon_info.options_script_version)
	end
	
	
	self.options_authors_text = addon_authors
	if self.addon_info.options_authors_text ~= nil then
		self.options_authors_text = tostring(self.addon_info.options_authors_text)
	end
	
	self.counter = 0
	self:SetWndSize(vector2():set(wnd_size.x, wnd_size.y))
	
	self.y_offset = 10
	self.addon_script_name = script_name
	self.options_variables = options_variables
	
	self.addon_background = get_options_xml():InitStatic("addon_background", self)
	self.addon_background:SetStretchTexture(true)
	self.addon_background:SetWndPos(vector2():set(5, 5))
	self.addon_background:SetWndSize(vector2():set(222, 70))
	self.addon_background:SetTextureColor(GetARGB(75, 255, 255, 255))
	
	self.addon_background_selected = get_options_xml():InitStatic("addon_background_selected", self)
	self.addon_background_selected:SetStretchTexture(true)
	self.addon_background_selected:SetWndPos(vector2():set(5, 5))
	self.addon_background_selected:SetWndSize(vector2():set(222, 70))
	self.addon_background_selected:SetTextureColor(GetARGB(75, 255, 255, 255))
	
	self.addon_icon = get_options_xml():InitStatic("addon_icon", self)
	self.addon_icon:InitTexture(self.icon_path)
	self.addon_icon:SetStretchTexture(true)
	self.addon_icon:SetWndPos(vector2():set(14, self.y_offset + 10))
	self.addon_icon:SetWndSize(vector2():set(64, 64))
	self.addon_icon:SetTextureColor(GetARGB(200, 255, 255, 255))
	
	fix_controll_size(self.addon_icon)
	
	if self.addon_info.options_title ~= nil then
		self.addon_title = get_options_xml():InitStatic("ixr_product_sans_16_l", self)
		self.addon_title:SetWndPos(vector2():set(64, self.y_offset + ((15 + 2) * self:get_counter())))
		self.addon_title:SetWndSize(vector2():set(250, 15))
		self.addon_title:TextControl():SetText(self.option_title)
		self.addon_title:TextControl():SetTextColor(color_option_title)
		self:add_counter()
	end
	
	if self.addon_info.options_title ~= nil then
		self.script_name = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	else
		self.script_name = get_options_xml():InitStatic("ixr_product_sans_16_l", self)
	end
	self.script_name:SetWndPos(vector2():set(64, self.y_offset + ((15 + 2) * self:get_counter())))
	self.script_name:SetWndSize(vector2():set(250, 15))
	self.script_name:TextControl():SetText("script: " .. self.addon_script_name)
	if self.addon_info.options_title ~= nil then
		self.script_name:TextControl():SetTextColor(color_platform)
	else
		self.script_name:TextControl():SetTextColor(color_option_title)
	end
	self:add_counter()
	
	self.addon_status = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	self.addon_status:SetWndPos(vector2():set(64, self.y_offset + ((15 + 2) * self:get_counter())))
	self.addon_status:SetWndSize(vector2():set(250, 15))
	self.addon_status:TextControl():SetText("Addon: " .. self.options_addon_name)
	self.addon_status:TextControl():SetTextColor(color_status)
	self:add_counter()
	
	self.addon_version = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	self.addon_version:SetWndPos(vector2():set(64, self.y_offset + ((15 + 2) * self:get_counter())))
	self.addon_version:SetWndSize(vector2():set(250, 15))
	self.addon_version:TextControl():SetText("Version: " .. self.options_script_version)
	self.addon_version:TextControl():SetTextColor(color_version)
	self:add_counter()
	
	self.addon_authors = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	self.addon_authors:SetWndPos(vector2():set(64, self.y_offset + ((15 + 2) * self:get_counter())))
	self.addon_authors:SetWndSize(vector2():set(250, 15))
	self.addon_authors:TextControl():SetText("Authors: " .. tostring(self.options_authors_text))
	self.addon_authors:TextControl():SetTextColor(color_platform)
	self:add_counter()
	
	self:SetWndSize(vector2():set(100, wnd_size.y))
	
	self.addon_background:SetWndSize(vector2():set(222, 90))
	self.addon_background_selected:SetWndSize(vector2():set(222, 90))

	self:SetSelectedState(false)
	
	-- for gamepads
	register_addon_for_gamepad(script_name, self)
end

function AddonItem:SetSelectedState(is_selected)
	if is_selected then
		self.addon_background:Show(false)
		self.addon_background_selected:Show(true)
	else
		self.addon_background:Show(true)
		self.addon_background_selected:Show(false)
	end
end

function AddonItem:add_counter()
	self.counter = self.counter + 1
end

function AddonItem:get_counter()
	return self.counter
end

-- #######################################
-- #	 	 TOOLS METHODS 	  	 	 	 #
-- #######################################
function _get_option_storage_path()
	_find_appdata_folder()
	return CONST_APPDATA_FOLDER .. "\\" .. OPTIONS_FILE_NAME
end

function _find_appdata_folder()
	if CONST_APPDATA_FOLDER == nil then
		CONST_APPDATA_FOLDER = getFS():update_path(APPDATA_ALIAS, '')
	end
end

function get_root_dir()
	return tostring(lfs.currentdir())
end

function get_addons_list()
    local addons_path = lfs.currentdir() .. "\\ixr_addons"
    
    if not lfs.attributes(addons_path) then
        return {}
    end
    
    local addons = {}
    
    local handle = io.popen('dir "' .. addons_path .. '" /B /AD')
    if handle then
        local result = handle:read("*a")
        handle:close()
        
        if result and result ~= "" then
            for addon_name in result:gmatch("[^\r\n]+") do
                if addon_name ~= "." and addon_name ~= ".." then
                    addons[addon_name] = get_scripts_for_addon(addons_path .. "\\" .. addon_name)
                end
            end
        end
    end
    
    local sorted_result = {}
    local addon_names = {}
    for addon_name, _ in pairs(addons) do
        table.insert(addon_names, addon_name)
    end
    
    table.sort(addon_names)
    
    local overridden_scripts = {}
    for i = #addon_names, 1, -1 do
        local addon_name = addon_names[i]
        local scripts = addons[addon_name]
        local filtered_scripts = {}

        for _, script_name in ipairs(scripts) do
            if not overridden_scripts[script_name] then
                table.insert(filtered_scripts, script_name)
            end
			
            overridden_scripts[script_name] = true
        end
        
        table.insert(sorted_result, 1, {
            addon_folder = addon_name,
            script_files_names = filtered_scripts
        })
    end
    
    return sorted_result
end

function get_scripts_for_addon(addon_path)
	local scripts_path = addon_path .. "\\scripts"
    local script_files = {}
    
    if lfs.attributes(scripts_path) then
		local handle = io.popen('dir "' .. scripts_path .. '\\*.script" /B /S 2>nul')
		if handle then
			local result = handle:read("*a")
			handle:close()
			
			if result and result ~= "" then
				for file_path in result:gmatch("[^\r\n]+") do
					local file_name = file_path:match("[^\\]+$")
					if file_name then
						table.insert(script_files, file_name)
					end
				end
			end
		end
	end
	
	return script_files
end