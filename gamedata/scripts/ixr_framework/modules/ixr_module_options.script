function getOptions()
	return ixr_options.options or {}
end

function getNextControllIndex()
	ixr_options._counter = ixr_options._counter + 1
	
	return ixr_options._counter
end

function on_apply_new_metadata_value(script, var_name, value, _self)
	--SemiLog(string.format("script:%s var_name:%s value:%s", tostring(script), tostring(var_name), tostring(value)) .. " == " .. tostring(_self.value))
