	if _ref == nil then
		_ref = get_menu_ref()
	end
	
	name_controll = name_controll .. "_checkbox_"
	
	set_controll(name_controll, IXRCheckBox(name_controll, x, y, alpha, def_value, _callback, _ref, script_name, variable_name))
