<shader r1_static="1">
	<normal sort="2" strict="1">
		<pass vs="model_distort" ps="model_exoscreen" zwrite="0" blend="srcalpha,one" aref="0">
			<texture name="s_base" src="@base"/>
		</pass>
	</normal>
	<option name="USE_R1_STATIC_LIGHTING">
		<normal sort="2" strict="1">
			<pass vs="r1_model_lplanes" ps="r1_exoscreen" zwrite="0" blend="srcalpha,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="ui\ui_mono_noise"/>
			</pass>
		</normal>
	</option>
</shader>
