<shader r1_static="1">
	<normal sort="2" strict="1" distort="1">
		<pass vs="model_distort" ps="model_scope_lense" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
			<texture name="s_base" src="@base"/>
			<texture name="s_vp2" src="$user$viewport2"/>
			<texture name="s_scope_ui" src="$user$ui_pda"/>
		</pass>
	</normal>
	<option name="USE_R1_STATIC_LIGHTING">
		<normal sort="2" strict="1">
			<pass vs="model_env_lq" ps="model_env_lq" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_env" src="sky\sky_5_cube"/>
			</pass>
		</normal>
	</option>
</shader>
