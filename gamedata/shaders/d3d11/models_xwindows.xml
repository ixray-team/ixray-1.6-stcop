<shader version="2" r1_static="1">
	<normal>
		<pass vs="deffer_model" ps="forward_base"/>
		<fog value="1"/>
		<zb test="1" write="0"/>
		<blend enable="1" src="one" dest="one"/>
		<aref enable="1" value="0"/>
		<sorting priority="3" strict="1"/>
		<texture name="s_base" value="{base}"/>
		<texture name="env_s0" value="$user$env_s0"/>
		<texture name="env_s1" value="$user$env_s1"/>
		<texture name="sky_s0" value="$user$sky0"/>
		<texture name="sky_s1" value="$user$sky1"/>
		<texture name="s_material" value="$user$material"/>
		<sampler name="smp_base"/>
		<sampler name="smp_rtlinear"/>
		<sampler name="smp_material"/>
	</normal>
	<l_special>
		<pass vs="model_distort4glass" ps="particle_distort_hard"/>
		<sorting priority="3" strict="1"/>
		<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
		<zb test="1" write="0"/>
		<fog value="0"/>
		<distort value="1"/>
		<texture name="s_base" value="{base}"/>
		<texture name="s_distort" value="pfx\pfx_dist_glass"/>
		<sampler name="smp_linear"/>
	</l_special>
	<static>
		<normal>
			<pass vs="model_env_lq" ps="model_env_lq"/>
			<fog value="1"/>
			<zb test="1" write="0"/>
			<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
			<aref enable="1" value="0"/>
			<sorting priority="3" strict="1"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_env" value="sky\sky_5_cube"/>
			<sampler name="smp_base"/>
			<sampler name="smp_rtlinear"/>
		</normal>
		<normal_hq>
			<pass vs="model_env_hq" ps="model_env_hq"/>
			<fog value="1"/>
			<zb test="1" write="0"/>
			<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
			<aref enable="1" value="0"/>
			<sorting priority="3" strict="1"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_env" value="sky\sky_5_cube"/>
			<texture name="s_lmap" value="$user$projector"/>
			<sampler name="smp_base"/>
			<sampler name="smp_rtlinear"/>
		</normal_hq>
		<l_point>
			<pass vs="model_def_point" ps="add_point"/>
			<fog value="0"/>
			<zb test="1" write="0"/>
			<blend enable="1" src="one" dest="one"/>
			<aref enable="1" value="0"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_lmap" value="internal\internal_light_attpoint"/>
			<texture name="s_att" value="internal\internal_light_attpoint"/>
			<sampler name="smp_base"/>
			<sampler name="smp_rtlinear"/>
		</l_point>
		<l_spot>
			<pass vs="model_def_spot" ps="add_spot"/>
			<fog value="0"/>
			<zb test="1" write="0"/>
			<blend enable="1" src="one" dest="one"/>
			<aref enable="1" value="0"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_lmap" value="internal\internal_light_att"/>
			<texture name="s_att" value="internal\internal_light_attclip"/>
			<sampler name="smp_base"/>
			<sampler name="smp_rtlinear"/>
		</l_spot>
		<l_special>
			<pass vs="model_distort4glass" ps="particle_distort_hard"/>
			<sorting priority="3" strict="1"/>
			<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
			<zb test="1" write="0"/>
			<fog value="0"/>
			<distort value="1"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_distort" value="pfx\pfx_dist_glass"/>
			<sampler name="smp_linear"/>
		</l_special>
	</static>
</shader>
