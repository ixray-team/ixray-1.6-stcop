<shader version="2">
	<normal>
		<pass vs="model_distort4glass" ps="particle_hard"/>
		<fog value="1"/>
		<zb test="1" write="0"/>
		<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
		<aref enable="1" value="0"/>
		<sorting priority="3" strict="1"/>
		<texture name="s_base" value="{base}"/>
		<sampler name="smp_base"/>
		<sampler name="smp_linear"/>
		<sampler name="smp_rtlinear"/>
		<sampler name="smp_material"/>
	</normal>
	<l_special>
		<pass vs="model_distort4glass" ps="particle_distort_hard"/>
		<sorting priority="2" strict="1"/>
		<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
		<zb test="1" write="1"/>
		<fog value="0"/>
		<distort value="1"/>
		<texture name="s_base" value="{base}"/>
		<texture name="s_distort" value="pfx\pfx_dist_glass3"/>
		<sampler name="smp_linear"/>
	</l_special>
</shader>
