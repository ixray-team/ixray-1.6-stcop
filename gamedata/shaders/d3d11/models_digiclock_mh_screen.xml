<shader r1_static="1">
	<normal emissive="1">
		<pass vs="deffer_model" ps="deffer_base" stencil="always,255,127,keep,replace,keep" stencil_ref="1">
			<texture name="s_base" src="@base"/>
		</pass>
	</normal>
	<l_special emissive="1">
		<pass vs="deffer_model" ps="model_digiclock_mh" zwrite="0">
			<texture name="s_base" src="@base"/>
		</pass>
	</l_special>
	<option name="USE_R1_STATIC_LIGHTING">
		<normal>
			<pass vs="deffer_model" ps="model_digiclock_mh">
				<texture name="s_base" src="@base"/>
			</pass>
		</normal>
		<l_point>
			<pass vs="model_def_point" ps="add_point" zwrite="0" blend="one,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="internal\internal_light_attpoint"/>
				<texture name="s_att" src="internal\internal_light_attpoint"/>
			</pass>
		</l_point>
		<l_spot>
			<pass vs="model_def_spot" ps="add_spot" zwrite="0" blend="one,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="internal\internal_light_att"/>
				<texture name="s_att" src="internal\internal_light_attclip"/>
			</pass>
		</l_spot>
	</option>
</shader>
