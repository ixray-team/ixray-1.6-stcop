<shader simplified="1">
	<normal cluster="1">
		<pass vs="r1_model_selflight" ps="r1_selflight">
			<texture name="s_base" src="@base"/>
		</pass>
	</normal>
	<normal_ui cluster="1" emissive="1">
		<pass vs="deffer_model" ps="ui_base" stencil="always,255,127,keep,replace,keep" stencil_ref="1">
			<texture name="s_base" src="@base"/>
			<texture name="env_s0" src="shaders\newsky_viewport#small"/>
			<texture name="sky_s0" src="shaders\newsky_viewport"/>
			<texture name="s_material" src="$user$material"/>
			<define name="USE_UI_DYNAMIC_LIGHT" value="1"/>
		</pass>
	</normal_ui>
</shader>
