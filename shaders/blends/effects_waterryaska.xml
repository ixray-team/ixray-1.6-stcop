<shader simplified="1">
	<normal sort="2" strict="1" distort="1" cluster="1">
		<pass vs="r1_water" ps="r1_water" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
			<texture name="s_base" src="water\water_ryaska1"/>
			<texture name="s_water_nmap" src="water\water_normal"/>
			<texture name="sky_s0" src="$user$sky0"/>
			<texture name="sky_s1" src="$user$sky1"/>
			<texture name="s_position" src="$user$position"/>
			<texture name="s_frame_before" src="$user$generic"/>
			<texture name="s_mirror_cube" src="$user$env_fwd"/>
			<texture name="s_mirror_cube_dist" src="$user$env_temp"/>
			<texture name="s_water_foam" src="water\water_foam"/>
			<texture name="s_water_caustic" src="water\water_caustic"/>
		</pass>
	</normal>
	<l_special sort="2" strict="1" distort="1" cluster="1">
		<pass vs="r1_waterd" ps="r1_waterd" zwrite="0" blend="srcalpha,invsrcalpha">
			<texture name="s_base" src="water\water_ryaska1"/>
			<texture name="s_distort0" src="water\water_dudv"/>
			<texture name="s_distort1" src="water\water_dudv"/>
		</pass>
	</l_special>
	<option name="USE_SURFACE_WBOIT">
		<normal sort="2" strict="1" oit="1" distort="1" cluster="1">
			<pass vs="r1_water" ps="r1_water" zwrite="0" blend="one,one" blend1="destcolor,zero" aref="0">
				<texture name="s_base" src="water\water_ryaska1"/>
				<texture name="s_water_nmap" src="water\water_normal"/>
				<texture name="sky_s0" src="$user$sky0"/>
				<texture name="sky_s1" src="$user$sky1"/>
				<texture name="s_position" src="$user$position"/>
				<texture name="s_frame_before" src="$user$generic"/>
				<texture name="s_mirror_cube" src="$user$env_fwd"/>
				<texture name="s_mirror_cube_dist" src="$user$env_temp"/>
				<texture name="s_water_foam" src="water\water_foam"/>
				<texture name="s_water_caustic" src="water\water_caustic"/>
				<define name="USE_SURFACE_WBOIT" value="1"/>
			</pass>
		</normal>
		<l_special sort="2" strict="1" distort="1" cluster="1">
			<pass vs="r1_waterd" ps="r1_waterd" zwrite="0" blend="srcalpha,invsrcalpha">
				<texture name="s_base" src="water\water_ryaska1"/>
				<texture name="s_distort0" src="water\water_dudv"/>
				<texture name="s_distort1" src="water\water_dudv"/>
			</pass>
		</l_special>
	</option>
</shader>
