<shader r1_static="1">
	<normal sort="3" strict="1">
		<pass vs="deffer_model" ps="forward_base" zwrite="0" blend="one,one" aref="0">
			<texture name="s_base" src="@base"/>
			<texture name="env_s0" src="$user$env_s0"/>
			<texture name="env_s1" src="$user$env_s1"/>
			<texture name="sky_s0" src="$user$sky0"/>
			<texture name="sky_s1" src="$user$sky1"/>
			<texture name="s_material" src="$user$material"/>
		</pass>
	</normal>
	<l_special sort="3" strict="1" distort="1">
		<pass vs="model_distort4glass" ps="particle_distort_hard" zwrite="0" blend="srcalpha,invsrcalpha">
			<texture name="s_base" src="@base"/>
			<texture name="s_distort" src="pfx\pfx_dist_glass4"/>
		</pass>
	</l_special>
	<option name="USE_R1_STATIC_LIGHTING">
		<normal_hq sort="3" strict="1">
			<pass vs="model_env_hq" ps="model_env_hq" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_env" src="sky\sky_5_cube"/>
				<texture name="s_lmap" src="$user$projector"/>
			</pass>
		</normal_hq>
		<normal sort="3" strict="1">
			<pass vs="model_env_lq" ps="model_env_lq" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_env" src="sky\sky_5_cube"/>
			</pass>
		</normal>
		<l_point>
			<pass vs="model_def_point" ps="add_point" zwrite="0" blend="one,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="internal\internal_light_attpoint"/>
				<texture name="s_att" src="internal\internal_light_attpoint"/>
			</pass>
		</l_point>
		<l_spot>
			<pass vs="model_def_spot" ps="add_spot" zwrite="0" blend="one,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="internal\internal_light_att"/>
				<texture name="s_att" src="internal\internal_light_attclip"/>
			</pass>
		</l_spot>
		<l_special sort="3" strict="1" distort="1">
			<pass vs="model_distort4glass" ps="particle_distort_hard" zwrite="0" blend="srcalpha,invsrcalpha">
				<texture name="s_base" src="@base"/>
				<texture name="s_distort" src="pfx\pfx_dist_glass4"/>
			</pass>
		</l_special>
	</option>
</shader>
