-- Install in the SGM addon's scripts directory; IXR Framework loads it automatically.
local SNIPER_INFO = "sgm_achievements_sniper"
local registered = false

local function apply_sniper_modifier()
    local actor = db.actor
    if not actor or not actor.weapons_modifiers then
        return
    end

    local coefficient = 1.0
    if actor:has_info(SNIPER_INFO) then
        coefficient = 1.0 + r_mod_params("number", "achievements_sniper_bonus", 0.20)
    end

    -- Assign an absolute coefficient: repeated events must not compound the bonus.
    actor:weapons_modifiers("hit_power_coeff", coefficient)
end

local function on_actor_info(npc, info_id)
    if info_id == SNIPER_INFO then
        apply_sniper_modifier()
    end
end

function on_game_start(data)
    if registered then
        return
    end

    RegisterScriptCallback("actor_on_first_update", apply_sniper_modifier)
    RegisterScriptCallback("actor_on_info_callback", on_actor_info)
    registered = true
end
