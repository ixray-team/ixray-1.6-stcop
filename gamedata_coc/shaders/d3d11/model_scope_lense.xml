<shader version="2" r1_static="1">
	<normal>
		<pass vs="deffer_model" ps="forward_base"/>
		<fog value="1"/>
		<zb test="1" write="0"/>
		<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
		<aref enable="1" value="0"/>
		<sorting priority="3" strict="1"/>
		<scope value="1"/>
		<texture name="s_base" value="{base}"/>
		<texture name="env_s0" value="$user$env_s0"/>
		<texture name="env_s1" value="$user$env_s1"/>
		<texture name="sky_s0" value="$user$sky0"/>
		<texture name="sky_s1" value="$user$sky1"/>
		<texture name="s_material" value="$user$material"/>
		<sampler name="smp_base"/>
		<sampler name="smp_rtlinear"/>
		<sampler name="smp_material"/>
	</normal>
	<l_special>
		<pass vs="scope_lense_mask" ps="scope_lense_mask"/>
		<zb test="0" write="1"/>
		<scope value="1"/>
		<fog value="0"/>
		<texture name="s_position" value="$user$position"/>
		<texture name="s_base" value="{base}"/>
		<sampler name="smp_base"/>
	</l_special>
	<static>
		<normal>
			<pass vs="model_env_lq" ps="model_env_lq"/>
			<fog value="1"/>
			<zb test="1" write="0"/>
			<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
			<aref enable="1" value="0"/>
			<sorting priority="2" strict="1"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_env" value="sky\sky_5_cube"/>
			<sampler name="smp_base"/>
			<sampler name="smp_rtlinear"/>
		</normal>
	</static>
</shader>
