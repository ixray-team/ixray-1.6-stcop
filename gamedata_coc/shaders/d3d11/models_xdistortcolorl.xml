<shader>
	<normal sort="2" strict="1" distort="1">
		<pass vs="model_distort" ps="particle_hard" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
			<texture name="s_base" src="@base"/>
		</pass>
	</normal>
	<normal_ui sort="2" strict="1">
		<pass vs="model_distort" ps="ui_particle" zwrite="0" blend="srcalpha,invsrcalpha" aref="0">
			<texture name="s_base" src="@base"/>
		</pass>
	</normal_ui>
	<l_special sort="3" distort="1">
		<pass vs="model_distort" ps="particle_distort_hard" zwrite="0" blend="srcalpha,invsrcalpha">
			<texture name="s_base" src="@base"/>
			<texture name="s_distort" src="@base"/>
		</pass>
	</l_special>
</shader>
