; Physical DOF profiles for R4 autofocus/manual. Static uses the legacy DOF settings.
; Distances and sensor height are meters, focal length is millimeters, times are seconds.
; sensor_height is global (r4_ndof_sensor_height), not a profile field.
; Missing profile fields inherit the console base camera. Invalid fields log a warning.
; LTX inheritance supplies explicit fields, so ndof_neutral overrides the console base.
; Restart the game after editing these cached profiles.

[ndof_neutral]
enabled              = true
ndof_mode            = autofocus
f_number             = 4.0
manual_focal_length  = false
focus_time           = 0.1
focus_point          = 0.5, 0.495
transition_time      = 0.1

; Used when the corresponding manual mode is selected.
focus_distance       = 1.4
focal_length         = 10.0

[ndof_talk]:ndof_neutral
[ndof_zone]:ndof_neutral
[ndof_pickable]:ndof_neutral
[ndof_inventory]:ndof_neutral
[ndof_pda]:ndof_neutral
[ndof_hud_animator]:ndof_neutral
[ndof_reload]:ndof_neutral
[ndof_weapon_action]:ndof_neutral
[ndof_aim]:ndof_neutral
[ndof_aim_alt]:ndof_neutral
[ndof_aim_grenade]:ndof_neutral
[ndof_aim_lens]:ndof_neutral
[ndof_effector]:ndof_neutral

; First eligible enabled event wins. Zone precedes pickable when both are active.
[ndof_events]
talk                 = ndof_talk
zone                 = ndof_zone
pickable             = ndof_pickable
inventory            = ndof_inventory
pda                  = ndof_pda
hud_animator         = ndof_hud_animator
reload               = ndof_reload
weapon_action        = ndof_weapon_action
aim                  = ndof_aim
aim_alt              = ndof_aim_alt
aim_grenade          = ndof_aim_grenade
aim_lens             = ndof_aim_lens
effector             = ndof_effector

; Optional references in HUD/item sections, using your own profile section names.
; ndof_profile_aim = my_aim_camera
; ndof_profile_anm_reload = my_reload_camera
; A scope section can override ndof_profile_aim_lens.
; An explicit enabled = false disables the event, including its fallback bindings.
; Other weapon animations require an explicit ndof_profile_<animation_alias> reference.
