[ws_default_element]
billboard = default_billboard   ; секция билборда из ui\billboards.xml
show = true                     ; показывать ли элемент по дефолту
show_distance = 10.0            ; дистанция от камеры до гейм обджекта больше которой элемент не показывается
attach_bone = nil               ; имя кости к которой можно прикрепить элемент. nil - прикрепляем к позиции гейм обджекта