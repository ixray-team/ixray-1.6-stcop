<shader r1_static="1">
	<normal sort="2">
		<pass vs="dumb" ps="dumb" zfunc="always" zwrite="0" blend="zero,one">
			<texture name="s_base" src="@base"/>
		</pass>
	</normal>
	<option name="USE_R1_STATIC_LIGHTING">
		<normal>
			<pass vs="r1_selflight" ps="r1_selflight">
				<texture name="s_base" src="@base"/>
			</pass>
		</normal>
		<l_point>
			<pass vs="r1_selflight_point" ps="add_point" zwrite="0" blend="one,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="internal\internal_light_attpoint"/>
				<texture name="s_att" src="internal\internal_light_attpoint"/>
			</pass>
		</l_point>
		<l_spot>
			<pass vs="r1_selflight_spot" ps="add_spot" zwrite="0" blend="one,one" aref="0">
				<texture name="s_base" src="@base"/>
				<texture name="s_lmap" src="internal\internal_light_att"/>
				<texture name="s_att" src="internal\internal_light_attclip"/>
			</pass>
		</l_spot>
		<l_special>
			<pass vs="r1_selflight" ps="r1_selflight">
				<texture name="s_base" src="@base"/>
			</pass>
		</l_special>
	</option>
</shader>
