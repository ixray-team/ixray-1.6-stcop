<shader version="2" r1_static="1">
	<normal>
		<pass vs="deffer_model" ps="model_scope_lense"/>
		<fog value="1"/>
		<zb test="1" write="0"/>
		<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
		<aref enable="1" value="0"/>
		<sorting priority="2" strict="1"/>
		<distort value="1"/>
		<texture name="s_base" value="{base}"/>
		<texture name="s_vp2" value="$user$viewport2"/>
		<texture name="s_scope_ui" value="$user$ui_pda"/>
		<sampler name="smp_base"/>
		<sampler name="smp_rtlinear"/>
	</normal>
	<static>
		<normal>
			<pass vs="model_env_lq" ps="model_env_lq"/>
			<fog value="1"/>
			<zb test="1" write="0"/>
			<blend enable="1" src="srcalpha" dest="invsrcalpha"/>
			<aref enable="1" value="0"/>
			<sorting priority="2" strict="1"/>
			<texture name="s_base" value="{base}"/>
			<texture name="s_env" value="sky\sky_5_cube"/>
			<sampler name="smp_base"/>
			<sampler name="smp_rtlinear"/>
		</normal>
	</static>
</shader>
