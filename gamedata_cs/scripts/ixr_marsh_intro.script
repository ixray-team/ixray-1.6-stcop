local new_game_pending = false

local function hide_starting_weapon()
	if not new_game_pending or not db.actor or level.name() ~= "marsh" or has_alife_info("mar_lvl_sim") then
		return false
	end

	level.show_weapon(false)
	-- Cancel the slot queued while the starting inventory is being filled.
	db.actor:activate_slot(0)
	return true
end

local function start()
	if not new_game_pending or not db.actor then
		return
	end

	local play_intro = hide_starting_weapon()
	new_game_pending = false
	if play_intro then
		db.actor:give_info_portion("mar_intro_start")
	end
end

function on_new_game()
	new_game_pending = true
end

function on_game_load()
	new_game_pending = false
end

function on_actor_first_update()
	if splash_screen.is_used_key_press_on_start_game() then
		hide_starting_weapon()
	else
		start()
	end
end

function on_movie_finished()
	start()
end

function on_game_start()
	RegisterScriptCallback("new_game_created", on_new_game)
	RegisterScriptCallback("save_file_loaded", on_game_load)
	RegisterScriptCallback("actor_on_item_take", hide_starting_weapon)
	RegisterScriptCallback("actor_on_first_update", on_actor_first_update)
end
