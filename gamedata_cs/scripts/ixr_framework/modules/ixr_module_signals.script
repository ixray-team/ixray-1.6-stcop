
--[[
	IX-Ray Module Signals
	Version: 1.0
	Author: FFx0001
	Script: ixr_module_signals.script
	Description: Module for centralized subscribes to game callbacks automatically callable in subscribed script on event called in external scripts
	
	Override options:
		script: __ixr_override_signals_intercepts.script
		auto callable function: configure(ixr_signals) then ixr_signals.add_intercept("event_name", {flat array string arg names}) end
	
	Public exports:
		get_module_info()
		init()
		is_initialized()
		add_intercept(name, args_map)
		remove_intercept(name)
		subscribe_to_event(name, func_or_userdata)
		callback_set(name, func_or_userdata)
		un_subscribe_from_event(name, func_or_userdata)
		callback_unset(name, func_or_userdata)
		send_event(name, ...)
		make_callback(name, ...)
]]

local ixr_signals = {
	intercepts = {},
	initialized = false,
	use_file_log = true,
	use_console_log = false,
}


-- #######################################
-- #	 	 PUBLIC METHODS 	  	 	 #
-- #######################################

--[[
Description: Module management. Returns metadata about the module.
Return: (table) - A table containing module information such as alias name, category, version, authors, and description.
]]
function get_module_info()
	return {
		-- (string) constant module name independent of the script name, which will be centralized via ixr_framework.get_module("alias_name") to maintain module versioning without the need to access the script name during integration.
		alias_name = "ixr_signals",
		
		-- (string) use once value at range or custom latin snake case name default categories: ["ixr_system", "sub_system", "sub_gameplay", "sub_utils"] use for ordering init calls at 1 to last ASC
		category = "ixr_system",
		
		-- (float) value for controll versions
		version = 1.0,
		
		-- (string) public exposed function name, allowed in this script for auto init module
		init_function_name = "init",
		
		-- (string|string[]) code author(s) nick name(s)
		authors = "FFx0001",
		
		-- (string) short description about module
		description = "Module for centralized subscribes to game callbacks automatically callable in subscribed script on event called in external scripts",
	}
end

--[[
Description: Initializes the module and sets up necessary configurations.
Return: (bool) - Returns true if the module was successfully initialized.
]]
function init()
	return ixr_signals.init()
end

--[[
Description: Checks whether the module has been initialized.
Return: (bool) - Returns true if the module is initialized, otherwise false.
]]
function is_initialized()
	return ixr_signals.is_initialized()
end

--[[
Description: Adds a new event type to the interception system.
Parameters:
  name (string)(required) - The name of the event to intercept.
  args_map (table)(optional) - A table mapping argument names for the event.
Return: (bool) - Returns true if the event type was successfully added.
]]
function add_intercept(name, args_map)
	return ixr_signals.add_intercept(name, args_map)
end

--[[
Description: Removes an event type from the interception system.
Parameters:
  name (string)(required) - The name of the event to remove.
Return: (bool) - Returns true if the event type was successfully removed.
]]
function remove_intercept(name)
	return ixr_signals.remove_intercept(name)
end

--[[
Description: Subscribes a function or userdata to a specified event.
Parameters:
  name (string)(required) - The name of the event to subscribe to.
  func (function|userdata)(required) - The function or userdata to be called when the event is triggered.
Return: (bool) - Returns true if the subscription was successful.
]]
function subscribe_to_event(name, func_or_userdata)
	return ixr_signals.subscribe_to_event(name, func_or_userdata)
end

--[[
Description: Alias for subscribing to an event.
Parameters:
  name (string)(required) - The name of the event to subscribe to.
  func (function|userdata)(required) - The function or userdata to be called when the event is triggered.
Return: (bool) - Returns true if the subscription was successful.
]]
function callback_set(name, func_or_userdata)
	return ixr_signals.subscribe_to_event(name, func_or_userdata)
end

--[[
Description: Unsubscribes a function or userdata from a specified event.
Parameters:
  name (string)(required) - The name of the event to unsubscribe from.
  func (function|userdata)(required) - The function or userdata to be removed from the subscription.
Return: (bool) - Returns true if the unsubscription was successful.
]]
function un_subscribe_from_event(name, func_or_userdata)
	return ixr_signals.un_subscribe_from_event(name, func_or_userdata)
end

--[[
Description: Alias for unsubscribing from an event.
Parameters:
  name (string)(required) - The name of the event to unsubscribe from.
  func (function|userdata)(required) - The function or userdata to be removed from the subscription.
Return: (bool) - Returns true if the unsubscription was successful.
]]
function callback_unset(name, func_or_userdata)
	return ixr_signals.un_subscribe_from_event(name, func_or_userdata)
end

--[[
Description: Sends an event to all subscribers.
Parameters:
  name (string)(required) - The name of the event to send.
  ... (vararg) - Additional parameters to pass to the event handlers.
Return: (void) - No return value.
]]
function send_event(name, ...)
	return ixr_signals.send_event(name, ...)
end

--[[
Description: Alias for sending an event to subscribers.
Parameters:
  name (string)(required) - The name of the event to send.
  ... (vararg) - Additional parameters to pass to the event handlers.
Return: (void) - No return value.
]]
function make_callback(name, ...)
	return ixr_signals.send_event(name, ...)
end

-- #######################################
-- #	 	 IX-Ray INTERCEPTS 	  	 	 #
-- #######################################
function ixr_signals.load_addons_intercepts()
	ixr_signals.toLog("\n[IXR SIGNALS] LOAD IXR ADDONS INTERCEPT SETTINGS\n", false)
	
	--// IXR addons
	ixr_signals.add_intercept("update",                          		{"delta_number"}) -- actor
	ixr_signals.add_intercept("load",                            		{"net_packet"}) -- actor
	ixr_signals.add_intercept("save",                            		{"net_packet"}) -- actor
	
	ixr_signals.add_intercept("save_file_loaded",                     	{"dir_path_string", "file_name_string"})
	ixr_signals.add_intercept("save_file_created",                		{"dir_path_string", "file_name_string"})
	ixr_signals.add_intercept("new_game_created",                       {"dir_path_string", "file_name_string"})
	ixr_signals.add_intercept("actor_on_spawn",                   		{})
end


