-- #######################################
-- #	 	 SYSTEM METHODS 	  	 	 #
-- #######################################
function ixr_signals.init()
	if ixr_signals.is_initialized() then
		return true
	end
	
	ixr_signals.toLog("[IXR SIGNALS] PREPARE INIT", true)
	
	if __ixr_override_signals_intercepts then 
		ixr_signals.load_addons_intercepts()
		ixr_signals.toLog("\n[IXR SIGNALS] LOAD OVERRIDED SETTINGS\n", false)
		__ixr_override_signals_intercepts.configure(this)
	else
		ixr_signals.load_default_intercepts()
	end
	
	if ffx_compare_utils.is_empty_flat_or_assoc_table(ixr_signals.intercepts) then
		ffx_dump_utils.AssertWithCaller(3, "IXR Signals", "failed to load intercepts on init")
		return false
	end
	
	ixr_signals.toLog("\n[IXR SIGNALS] SETTINGS LOADED\n", false)
	
	ixr_signals.initialized = true
	
	ixr_signals.toLog("\n[IXR SIGNALS] INITIALIZED\n", false)
	
	return true
end

function ixr_signals.is_initialized()
	return ixr_signals.initialized
end

function ixr_signals.subscribe_to_event(name, func_or_userdata)
	ixr_signals.init()
	
	if (func_or_userdata == nil) then
		ffx_dump_utils.AssertWithCaller(5, "IXR Signals", "Call RegisterCallback on ["..name.."] event without callback function, use format RegisterCallback(event_name, self_callback_function)")
		return false
	end

	if (name == nil) then
		ffx_dump_utils.AssertWithCaller(5, "IXR Signals", "Call RegisterCallback on empty event name, use format RegisterCallback(event_name, self_callback_function)")
		return false
	end
	
	if (ixr_signals.intercepts == nil) then
		ffx_dump_utils.AssertWithCaller(5, "IXR Signals", "failed to load intercepts on call RegisterCallback")
		return false
	end

	if (ixr_signals.intercepts[name]) then
		local caller = tostring(ffx_callable_utils.find_caller_source(4))
		ixr_signals.toLog(ixr_signals.format_subscribe_log("ADD", name, caller), false)
		ixr_signals.intercepts[name][func_or_userdata] = true
	end
end

function ixr_signals.format_subscribe_log(action, name, caller)
    local event_text = "EVENT:[" .. tostring(name) .. "]"
    local script_text = "SCRIPT:[" .. caller .. "]"
    
    return string.format("[IXR SIGNALS] %s SUBSCRIBE: %-50s %s",action, event_text, script_text)
end

function ixr_signals.un_subscribe_from_event(name, func_or_userdata)
	ixr_signals.init()
	
	if (ixr_signals.intercepts[name]) then
		local caller = tostring(ffx_callable_utils.find_caller_source(4))
		ixr_signals.toLog(ixr_signals.format_subscribe_log("REMOVE", name, caller), false)
		ixr_signals.intercepts[name][func_or_userdata] = nil
	end
end

function ixr_signals.send_event(name, ...)
	ixr_signals.init()
	
	if (not ixr_signals.intercepts[name]) then
		return
	end
	
	for func_or_userdata,v in pairs(ixr_signals.intercepts[name]) do 
		if (type(func_or_userdata) == "function") then 
			func_or_userdata(...)
		elseif (func_or_userdata[name]) then
			func_or_userdata[name](func_or_userdata, ...)
		end
	end
end

function ixr_signals.add_intercept(name, args_map)
	-- todo args_map check
	if (ixr_signals.intercepts[name]) then
		return false
	end
	
	if args_map and not ffx_compare_utils.is_empty_flat_or_assoc_table(args_map) then
		ixr_signals.toLog("[IXR SIGNALS] ADD INTERCEPT: ".. tostring(name) .."(".. ffx_json_lib.json_encode(args_map) ..")", false)
	else
		ixr_signals.toLog("[IXR SIGNALS] ADD INTERCEPT: ".. tostring(name) .."()", false)
	end
	
	ixr_signals.intercepts[name] = {}
	
	return true
end

function ixr_signals.remove_intercept(name)
	if (not ixr_signals.intercepts[name]) then
		return false
	end
	
	ixr_signals.intercepts[name] = nil
	ixr_signals.toLog("[IXR SIGNALS] REMOVE INTERCEPT: ".. tostring(name), false)
	
	return true
end

function ixr_signals.toLog(text, overwrite, log_name__auto)
	if ixr_signals.use_file_log then
		ffx_dump_utils.write_to_file_log(text, overwrite, log_name__auto)
	end
	
	if ixr_signals.use_console_log then
		ffx_dump_utils.write_to_console_log(text)
	end
end