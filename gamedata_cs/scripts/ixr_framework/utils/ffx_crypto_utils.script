
--[[
Description: Calculate CRC64 hash of input string
Parameters:
  input (string)(required) - Input string to calculate CRC64 hash
Return: (string) - CRC64 hash as hexadecimal string
]]
function calculate_crc64(input)
	return FFxCrypto():crc64(input)
end

--[[
Description: Calculate SHA-1 hash of input string
Parameters:
  input (string)(required) - Input string to calculate SHA-1 hash
Return: (string) - SHA-1 hash as hexadecimal string
]]
function calculate_sha1(input)
	return FFxCrypto():sha1(input)
end

--[[
Description: Calculate SHA-256 hash of input string
Parameters:
  input (string)(required) - Input string to calculate SHA-256 hash
Return: (string) - SHA-256 hash as hexadecimal string
]]
function calculate_sha256(input)
	return FFxCrypto():sha256(input)
end

--[[
Description: Encode input string to Base64 format
Parameters:
  input (string)(required) - Input string to encode
Return: (string) - Base64 encoded string
]]
function base64_encode(input)
	return FFxCrypto():base64_encode(input)
end

--[[
Description: Decode Base64 string to original format
Parameters:
  input (string)(required) - Base64 string to decode
Return: (string) - Decoded original string
]]
function base64_decode(input)
	return FFxCrypto():base64_decode(input)
end

--[[
Description: Encode input string using XOR cipher with specified key
Parameters:
  input (string)(required) - Input string to encode
  key (string)(required) - XOR encryption key
Return: (string) - XOR encoded string
]]
function xor_encode(input, key)
	return FFxCrypto():xor_encode(input, key)
end