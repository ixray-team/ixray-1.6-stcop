--[[
    IXR Random Number Generator Library
    Version: 1.0
    Author: FFx0001
    Script: ffx_random_lib.script
    Description: High-quality pseudorandom number generator based on hash function, provides deterministic random sequences with seed control and range normalization.

    Features:
        - Hash-based random number generation for better distribution
        - Automatic seed initialization with system time
        - Range normalization for inverted min ~ max values
        - Automatic integer rounding when both bounds are integers
        - Reproducible sequences with fixed seeds

    Public exports:
		init()
        set_seed(val)
        rand(low, high)
		rand(high)
--]]

local ffx_random = {
    seed = nil,                             -- Current seed value for random generation
    counter = 0,                            -- Call counter for sequence generation
    hash_prime_multiplier_1 = 134775813,    -- Large prime number for first multiplication
    hash_prime_multiplier_2 = 2246822519,   -- Large prime number for second multiplication
    hash_prime_multiplier_3 = 3266489917,   -- Large prime number for third multiplication
    hash_prime_addition = 12345,            -- Prime number for addition in hash function
    hash_positive_mask = 0x7FFFFFFF,        -- Bit mask for positive numbers (2^31 - 1)
    hash_normalization_max = 0x7FFFFFFF     -- Maximum value for normalization to [0,1] range
}

--#####################################################
--#					PUBLIC EXPORTS					  #
--#####################################################

--[[
Description:
  Init library.
]]
function init()
   ffx_random.init()
end

--[[
Description:
  Sets the seed for random number generation.
Parameters:
  val (number) - the seed value to set.
]]
function set_seed(val)
    init()
    ffx_random.set_seed(val)
end

--[[
Description:
  Generates a random number in specified range.
Parameters:
  low (number or nil) - lower bound of the range, or upper bound if high is nil.
  high (number or nil) - upper bound of the range.
Returns: number
]]

function rand(low, high)   
    return ffx_random.rand(low, high)
end

--#####################################################
--#					SYSTEM LOGIC					  #
--#####################################################

function ffx_random.init()
    if not ffx_random.seed then
        ffx_random.set_seed(os.time())
    end
end

function ffx_random.hash(value)
    local x = value * ffx_random.hash_prime_multiplier_1 + ffx_random.hash_prime_addition
    x = x ~ (x >> 16)
    x = x * ffx_random.hash_prime_multiplier_2
    x = x ~ (x >> 13)
    x = x * ffx_random.hash_prime_multiplier_3
    x = x ~ (x >> 16)
    return x & ffx_random.hash_positive_mask
end

function ffx_random.generate()
    ffx_random.counter = ffx_random.counter + 1
    local combined = ffx_random.seed + ffx_random.counter
    local hashed = ffx_random.hash(combined)
    return hashed / ffx_random.hash_normalization_max
end

function ffx_random.set_seed(val)
    ffx_random.seed = math.floor(val)
    ffx_random.counter = 0
end

function ffx_random.normalize_range(low, high)
    if low and high then
        if low > high then
            low = high
        end
        if high < low then
            high = low
        end
    elseif low then
        if low < 0 then
            low = 0
        end
    end
    return low, high
end

function ffx_random.rand(low, high)
    init()
    
    low, high = ffx_random.normalize_range(low, high)
    
    local result = ffx_random.generate()
    
    if low and high then
        result = low + result * (high - low)
        
        if math.floor(low) == low and math.floor(high) == high then
            result = math.floor(result + 0.5)
        end
    elseif low then
        result = result * low
        
        if math.floor(low) == low then
            result = math.floor(result + 0.5)
        end
    end
    
    return result
end

--#####################################################
--#						TESTS						  #
--#####################################################

function toLog(str, ...)
	SemiLog(string.format(str, ...))
end

function tests()
	-- Тесты для библиотеки случайных чисел
	toLog("=== ТЕСТЫ БИБЛИОТЕКИ RAND ===")

	-- Тест 1: Базовые вызовы
	toLog("\n1. Базовые вызовы:")
	toLog("rand() =", rand())           -- число от 0 до 1
	toLog("rand() =", rand())           -- другое число от 0 до 1
	toLog("rand(10) =", rand(10))       -- число от 0 до 10
	toLog("rand(5, 15) =", rand(5, 15)) -- число от 5 до 15

	-- Тест 2: Выравнивание значений
	toLog("\n2. Выравнивание значений:")
	toLog("rand(10, 5) =", rand(10, 5))     -- должно стать rand(5, 10)
	toLog("rand(3, 3) =", rand(3, 3))       -- всегда 3
	toLog("rand(-5, 10) =", rand(-5, 10))   -- работает с отрицательными
	toLog("rand(7.5, 2.5) =", rand(7.5, 2.5)) -- выравнивается до [2.5, 7.5]

	toLog("rand(1, 10) =", rand(1, 10))         -- целое число
	toLog("rand(1.5, 10.5) =", rand(1.5, 10.5)) -- дробное число
	toLog("rand(1, 10.5) =", rand(1, 10.5))     -- смешанные типы

	-- Тест 4: Установка сида
	toLog("\n4. Установка сида:")
	set_seed(12345)
	local test1 = rand(1, 100)
	local test2 = rand(1, 100)
	toLog("При seed=12345:")
	toLog("test1 =", test1)
	toLog("test2 =", test2)

	-- Проверка воспроизводимости
	set_seed(12345)
	local test1_repeat = rand(1, 100)
	local test2_repeat = rand(1, 100)
	toLog("Повтор при том же seed=12345:")
	toLog("test1_repeat =", test1_repeat)
	toLog("test2_repeat =", test2_repeat)
	toLog("Результаты совпадают:", test1 == test1_repeat and test2 == test2_repeat)

	-- Тест 5: Множественные вызовы
	toLog("\n5. Множественные вызовы (5 чисел):")
	for i = 1, 5 do
		toLog(i .. ":", rand(1, 50))
	end

	-- Тест 6: Граничные случаи
	toLog("\n6. Граничные случаи:")
	toLog("rand(0) =", rand(0))           -- 0
	toLog("rand(0, 0) =", rand(0, 0))     -- 0
	toLog("rand(-10) =", rand(-10))       -- 0 (выравнивание для одного аргумента)
	toLog("rand(100, 100) =", rand(100, 100)) -- 100

	-- Тест 7: Проверка диапазонов
	toLog("\n7. Проверка диапазонов (10 чисел от 20 до 30):")
	for i = 1, 10 do
		local num = rand(20, 30)
		toLog(i .. ":", num, "в диапазоне:", num >= 20 and num <= 30)
	end

	-- Тест 8: Дробные числа
	toLog("\n8. Дробные числа:")
	toLog("rand(0.1, 0.9) =", rand(0.1, 0.9))
	toLog("rand(1.25, 3.75) =", rand(1.25, 3.75))

	-- Тест 8: Проверка диапазонов
	toLog("\n7. Проверка диапазонов (10 чисел от 0.5 до 30):")
	for i = 1, 10 do
		local num = rand(0.5, 30)
		toLog(i .. ":", num, "в диапазоне:", num >= 0.5 and num <= 30)
	end
	toLog("\n=== ТЕСТЫ ЗАВЕРШЕНЫ ===")
end


--[[

local ffx_random = {
    -- Основные настройки
    seed = nil,
    state = nil, -- будет байтовым массивом (правая часть - следующий сид)
    is_initialized = false,
    
    -- Константы для байтовых массивов
    BYTE_ARRAY_SIZE = 8,  -- 8 байт = 64 бита
    HALF_SIZE = 4,        -- 4 байта = 32 бита
    
    -- Для переопределения math функций
    original_math_random = nil,
    original_math_randomseed = nil,
    is_overridden = false,
}

--#####################################################
--#					PUBLIC EXPORTS					  #
--#####################################################

function init()
   ffx_random.init()
end

function set_seed(val)
    ffx_random.set_seed(val)
end

function rand(low, high)   
    return ffx_random.rand(low, high)
end

function override_math_random()
    ffx_random.override_math_functions()
end

function restore_math_random()
    ffx_random.restore_math_functions()
end

function is_math_overridden()
    return ffx_random.is_overridden
end

--#####################################################
--#	 РЕАЛИЗАЦИЯ С БАЙТОВЫМИ МАССИВАМИ                 #
--#####################################################

-- Преобразование числа в байтовый массив
function ffx_random.number_to_bytes(num)
    local bytes = {}
    local temp = math.floor(num or 0)
    
    for i = 1, ffx_random.BYTE_ARRAY_SIZE do
        bytes[i] = temp & 0xFF  -- Младшие 8 бит
        temp = math.floor(temp / 256)  -- Сдвиг вправо на 8 бит
        if temp < 0 then temp = 0 end
    end
    
    return bytes
end

-- Преобразование байтового массива в число
function ffx_random.bytes_to_number(bytes)
    local result = 0
    local multiplier = 1
    
    for i = 1, #bytes do
        result = result + (bytes[i] or 0) * multiplier
        multiplier = multiplier * 256
    end
    
    return result
end

-- Улучшенная хеш-функция для байтового массива
function ffx_random.hash_bytes(bytes)
    local hash_bytes = {}
    
    for i = 1, ffx_random.BYTE_ARRAY_SIZE do
        local byte = bytes[i] or 0
        
        -- Используем несколько соседних байтов для лучшего перемешивания
        local prev1 = bytes[i-1] or bytes[ffx_random.BYTE_ARRAY_SIZE] or 0
        local prev2 = bytes[i-2] or bytes[ffx_random.BYTE_ARRAY_SIZE-1] or 0
        local next1 = bytes[i+1] or bytes[1] or 0
        local next2 = bytes[i+2] or bytes[2] or 0
        
        -- Комбинируем с разными множителями и XOR операциями
        local hashed = byte * 167
        hashed = hashed + prev1 * 113
        hashed = hashed + prev2 * 79
        hashed = hashed + next1 * 227
        hashed = hashed + next2 * 193
        hashed = hashed ~ (i * 97)  -- XOR с индексом
        hashed = hashed ~ (byte * 43)  -- XOR с самим байтом
        
        hash_bytes[i] = hashed & 0xFF  -- Гарантируем байтовый диапазон
    end
    
    return hash_bytes
end

-- Разделение байтового массива на левую и правую части
function ffx_random.split_bytes(bytes)
    local left = {}
    local right = {}
    
    for i = 1, ffx_random.HALF_SIZE do
        left[i] = bytes[i] or 0
        right[i] = bytes[i + ffx_random.HALF_SIZE] or 0
    end
    
    return left, right
end

-- Создание начального состояния из сида
function ffx_random.create_initial_state(seed)
    local state_bytes = ffx_random.number_to_bytes(seed)
    
    -- Прогреваем хеш несколько раз для лучшего перемешивания
    for i = 1, 10 do
        state_bytes = ffx_random.hash_bytes(state_bytes)
    end
    
    return state_bytes
end

-- Функция нормализации
function ffx_random.bytes_to_uniform_float(bytes)
    -- Комбинируем первые 3 байта в 24-битное число
    local main_part = 0
    main_part = main_part + (bytes[1] or 0) * 65536  -- << 16
    main_part = main_part + (bytes[2] or 0) * 256    -- << 8
    main_part = main_part + (bytes[3] or 0)          -- << 0
    
    -- Используем 4-й байт как дробную часть
    local fractional = (bytes[4] or 0) / 256.0
    
    -- Комбинируем основную часть и дробную часть
    local combined = main_part + fractional
    
    -- Нормализуем к диапазону [0, 1)
    local result = combined / 16777216.0
    
    return math.max(0.0, math.min(0.9999999999, result))
end

-- ОСНОВНОЙ ГЕНЕРАТОР
function ffx_random.generate()
    -- Инициализация состояния если нужно
    if not ffx_random.state then
        local seed = ffx_random.seed or os.time() * 1000
        ffx_random.state = ffx_random.create_initial_state(seed)
    end
    
    -- 1. Берем текущее состояние
    local current_state = ffx_random.state
    
    -- 2. Генерируем хеш от текущего состояния
    local hash_bytes = ffx_random.hash_bytes(current_state)
    
    -- 3. Разделяем хеш на левую (результат) и правую (следующий сид) части
    local result_bytes, next_state_bytes = ffx_random.split_bytes(hash_bytes)
    
    -- 4. Обновляем состояние для следующей итерации
    ffx_random.state = next_state_bytes
    
    -- 5. Преобразуем левую часть в равномерно распределенное число [0, 1)
    local result = ffx_random.bytes_to_uniform_float(result_bytes)
    
    return result
end

function ffx_random.init()
    if not ffx_random.is_initialized then
        local seed = os.time() * 1000
        ffx_random.seed = seed
        ffx_random.state = ffx_random.create_initial_state(seed)
        ffx_random.is_initialized = true
        
        -- Прогрев генератора (10 итераций вхолостую)
        for i = 1, 10 do
            ffx_random.generate()
        end
    end
end

function ffx_random.set_seed(val)
    local seed = math.floor(val)
    ffx_random.seed = seed
    ffx_random.state = ffx_random.create_initial_state(seed)
    ffx_random.is_initialized = true
    
    -- Прогрев генератора (10 итераций вхолостую)
    for i = 1, 10 do
        ffx_random.generate()
    end
end

-- ИСПРАВЛЕННАЯ ФУНКЦИЯ НОРМАЛИЗАЦИИ ДИАПАЗОНА
function ffx_random.normalize_range(low, high)
    local original_low, original_high = low, high
    
    if low and high then
        -- Есть оба аргумента
        if low > high then
            low, high = high, low
            original_low, original_high = original_high, original_low
        end
        
        -- Сохраняем информацию о типах исходных аргументов
        local low_is_integer = (math.type and math.type(original_low) == "integer") or 
                              (original_low % 1 == 0 and math.floor(original_low) == original_low)
        local high_is_integer = (math.type and math.type(original_high) == "integer") or 
                               (original_high % 1 == 0 and math.floor(original_high) == original_high)
        
        return low, high, "both", not (low_is_integer and high_is_integer)
        
    elseif low then
        -- Есть только один аргумент
        local low_is_integer = (math.type and math.type(original_low) == "integer") or 
                              (original_low % 1 == 0 and math.floor(original_low) == original_low)
        
        if low_is_integer then
            return 1, low, "integer"
        else
            return 0, low, "float"
        end
    else
        -- Нет аргументов
        return nil, nil, "none"
    end
end

-- ОСНОВНАЯ ФУНКЦИЯ РАНДОМА - ПОЛНОСТЬЮ ИСПРАВЛЕННАЯ!
-- Исправленная функция рандома
-- Исправленная функция рандома с правильной проверкой типов
function ffx_random.rand(low, high)
    -- Инициализация только если не инициализирован
    if not ffx_random.is_initialized then
        ffx_random.init()
    end
    
    local normalized_low, normalized_high, range_type, is_float_range = ffx_random.normalize_range(low, high)
    local random_value = ffx_random.generate()
    
    if range_type == "both" then
        -- Оба аргумента предоставлены
        local range = normalized_high - normalized_low
        
        -- ИСПРАВЛЕНИЕ: Используем информацию о типах из normalize_range
        if is_float_range then
            -- Хотя бы один аргумент был дробным - возвращаем дробные числа
            random_value = normalized_low + random_value * range
        else
            -- Оба аргумента были целыми - возвращаем целые числа
            random_value = math.floor(normalized_low + random_value * (range + 1))
            random_value = math.max(normalized_low, math.min(normalized_high, random_value))
        end
        
    elseif range_type == "integer" then
        -- Один аргумент, целое число
        random_value = math.floor(1 + random_value * normalized_high)
        random_value = math.max(1, math.min(normalized_high, random_value))
    elseif range_type == "float" then
        -- Один аргумент, дробное число
        random_value = random_value * normalized_high
    else
        -- Без аргументов - возвращаем [0,1) как есть
    end
    
    return random_value
end

-- Улучшенная функция установки сида с лучшим прогревом
function ffx_random.set_seed(val)
    local seed = math.floor(val)
    ffx_random.seed = seed
    ffx_random.state = ffx_random.create_initial_state(seed)
    ffx_random.is_initialized = true
    
    -- УЛУЧШЕННЫЙ ПРОГРЕВ: больше итераций и использование разных частей хеша
    for i = 1, 20 do
        ffx_random.generate()
    end
end

--#####################################################
--#     ТЕСТ ИСПРАВЛЕННОЙ ВЕРСИИ                     #
--#####################################################

function test_fixed_normalization()
    print("=== ТЕСТ ИСПРАВЛЕННОЙ НОРМАЛИЗАЦИИ ===")
    
    -- Полностью сбрасываем генератор
    ffx_random.seed = nil
    ffx_random.state = nil
    ffx_random.is_initialized = false
    
    ffx_random.set_seed(12345)
    
    print("1. rand(0.0, 5.0) - ДОЛЖНЫ быть дробные числа:")
    for i = 1, 10 do
        local num = ffx_random.rand(0.0, 5.0)
        print(string.format("  %2d: %.6f (тип: %s)", i, num, math.type and math.type(num) or type(num)))
    end
    
    print("\n2. rand(0, 5) - целые числа:")
    for i = 1, 5 do
        local num = ffx_random.rand(0, 5)
        print(string.format("  %d: %d (тип: %s)", i, num, math.type and math.type(num) or type(num)))
    end
    
    print("\n3. rand(1.5, 4.5) - дробные числа:")
    for i = 1, 5 do
        local num = ffx_random.rand(1.5, 4.5)
        print(string.format("  %d: %.6f (тип: %s)", i, num, math.type and math.type(num) or type(num)))
    end
    
    print("\n4. rand(2.0, 8.0) - дробные числа (оба с .0):")
    for i = 1, 5 do
        local num = ffx_random.rand(2.0, 8.0)
        print(string.format("  %d: %.6f (тип: %s)", i, num, math.type and math.type(num) or type(num)))
    end
end

function test_edge_cases()
    print("\n=== ТЕСТ ГРАНИЧНЫХ СЛУЧАЕВ ===")
    
    ffx_random.seed = nil
    ffx_random.state = nil
    ffx_random.is_initialized = false
    
    ffx_random.set_seed(999)
    
    print("1. rand(0.0, 1.0) - малый дробный диапазон:")
    for i = 1, 5 do
        local num = ffx_random.rand(0.0, 1.0)
        print(string.format("  %d: %.6f", i, num))
    end
    
    print("\n2. rand(0, 1) - малый целый диапазон:")
    for i = 1, 5 do
        local num = ffx_random.rand(0, 1)
        print(string.format("  %d: %d", i, num))
    end
    
    print("\n3. Смешанные типы - rand(1.5, 10):")
    for i = 1, 5 do
        local num = ffx_random.rand(1.5, 10)
        print(string.format("  %d: %.6f", i, num))
    end
end

-- Запускаем тесты
test_fixed_normalization()
test_edge_cases()

--]]