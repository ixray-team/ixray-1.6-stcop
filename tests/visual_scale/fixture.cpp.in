class SaveAccess:public CSaveObjectSave{public:CSaveChunk* Root(){return _rootChunk;}};
void TestPersistence(){
 for(float Scale:{0.5f,1.f,2.75f}){
  CSE_ALifeObject Source;Source.VisualScale=Scale;Source.m_flags.zero();Source.m_ini_string="";
  NET_Packet P;Source.STATE_Write(P);P.r_seek(0);CSE_ALifeObject Dest;Dest.STATE_Read(P,0);Near(Dest.VisualScale,Scale);Check(Dest.m_tNodeID==11);Check(P.r_eof());
  SaveAccess Save;Source.STATE_Serialize(Save);CSaveObjectLoad Load(Save.Root());CSE_ALifeObject Restored;Restored.STATE_Serialize(Load);Near(Restored.VisualScale,Scale);
 }
 // Old spawn packets have no scale field, so retain the section default.
 CSE_ALifeObject Source;Source.m_flags.zero();Source.m_ini_string="";NET_Packet P;Source.STATE_Write(P);P.r_seek(0);
 CSE_ALifeObject Old;Old.m_wVersion=134;Old.VisualScale=1.25f;Old.STATE_Read(P,0);Near(Old.VisualScale,1.25f);Check(P.r_tell()+sizeof(float)==P.w_tell());
 for(float Invalid:{0.f,-1.f,101.f,std::numeric_limits<float>::infinity()}){
  CSE_ALifeObject Bad;Bad.VisualScale=Invalid;Bad.m_flags.zero();Bad.m_ini_string="";NET_Packet Packet;Bad.STATE_Write(Packet);Packet.r_seek(0);CSE_ALifeObject Loaded;Loaded.STATE_Read(Packet,0);Near(Loaded.VisualScale,1);
 }
 puts("PASS: NET_Packet roundtrip, unique object scales, advanced save roundtrip, legacy packet compatibility");
}
