void Check(bool Value){ if(!Value){puts("FAIL"); exit(1);} }
void Near(float A,float B){Check(std::abs(A-B)<0.001f);}
void Near(const Fvector&A,const Fvector&B){Near(A.x,B.x);Near(A.y,B.y);Near(A.z,B.z);}
void TestSkeleton(){
 CBoneData Root(0),Child(1),Tip(2);
 Root.bind_transform.setXYZ(0.1f,0.3f,0.2f);Root.bind_transform.c.set(1,2,3);
 Child.bind_transform.setXYZ(0.2f,0.1f,0.4f);Child.bind_transform.c.set(2,1,0);
 Tip.bind_transform.identity();Tip.bind_transform.c.set(0,3,0);
 Root.children.push_back(&Child);Child.children.push_back(&Tip);
 Root.obb.identity();Child.obb.identity();Tip.obb.identity();
 for(auto* B:{&Root,&Child,&Tip}){B->center_of_mass.set(1,2,3);B->obb.m_halfsize.set(1,2,3);}
 Root.shape.type=SBoneShape::stBox;Root.shape.box.identity();Root.shape.box.m_halfsize.set(1,2,3);Root.shape.box.m_translate.set(2,3,4);
 Child.shape.type=SBoneShape::stSphere;Child.shape.sphere.P.set(1,2,3);Child.shape.sphere.R=2;
 Tip.shape.type=SBoneShape::stCylinder;Tip.shape.cylinder.m_center.set(2,3,4);Tip.shape.cylinder.m_height=3;Tip.shape.cylinder.m_radius=2;
 Root.CalculateM2B(Fidentity);vecBones Source={&Root,&Child,&Tip};
 CKinematics A,B; A.bones=B.bones=&Source;
 for(auto* K:{&A,&B}){K->vis.box.set(-1,-2,-3,1,2,3);K->vis.sphere.P.set(0,0,0);K->vis.sphere.R=3;}
 for(float Scale:{0.5f,2.f,0.25f,3.f,1.f}){
  A.SetVisualScale(Scale);Near(A.VisualScale,Scale);Near(B.bones->at(1)->shape.sphere.R,2);Near(Root.bind_transform.c,Fvector().set(1,2,3));
  Near(A.bones->at(0)->shape.box.m_halfsize,Fvector().set(Scale,2*Scale,3*Scale));
  Near(A.bones->at(0)->shape.box.m_translate,Fvector().set(2*Scale,3*Scale,4*Scale));
  Near(A.bones->at(1)->shape.sphere.R,2*Scale);Near(A.bones->at(1)->shape.sphere.P,Fvector().set(Scale,2*Scale,3*Scale));
  Near(A.bones->at(2)->shape.cylinder.m_height,3*Scale);Near(A.bones->at(2)->shape.cylinder.m_radius,2*Scale);
  Check(A.bones->at(0)->children[0]==A.bones->at(1));
  CBoneInstance R,C;R.construct();C.construct();
  A.CLBone(A.bones->at(0),R,&Fidentity);A.CLBone(A.bones->at(1),C,&R.mTransform);
  Fvector V={3,4,5},P;C.mRenderTransform.transform_tiny(P,V);Near(P,Fvector().mul(V,Scale));
  Near(C.mTransform.i.magnitude(),1); // ODE receives a rigid transform, no scaled rotations.
 }
 A.SetVisualScale(2);A.ResetVisualScale();Check(A.bones==&Source);Near(A.VisualScale,1);Near(A.vis.sphere.R,3);
 A.SetVisualScale(-1);A.SetVisualScale(std::numeric_limits<float>::quiet_NaN());Near(A.VisualScale,1);
 puts("PASS: independent instances, every shape, rigid transforms, skinning, rescale and pool reset");
}
class CSE_ALifeObject {
