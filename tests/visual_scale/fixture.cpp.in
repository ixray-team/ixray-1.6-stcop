 animation_movement_controller C;C.CurrentRoot.identity();C.CurrentRoot.c.set(1,2,3);C.m_startObjXForm.setXYZ(0,.3f,0);C.m_startObjXForm.c.set(10,20,30);
 C.m_pObjXForm.mul_43(C.m_startObjXForm,C.CurrentRoot);Fmatrix Initial=C.m_pObjXForm;
 Fmatrix A=Initial,B=Initial;A.c.x-=.37f;B.c.x+=.63f;C.m_poses_blending=poses_blending(A,B,1);
 float Previous=1;
 for(float Scale:{4.f,.1f,1.f,1.001f}){
  C.CurrentRoot.c.set(Scale,2*Scale,3*Scale);C.OnVisualScaleChanged(Scale/Previous);
  Fmatrix Actual;Actual.mul_43(C.m_startObjXForm,C.CurrentRoot);Near(Actual.c,Initial.c);Near(C.Phase,.37f);
  C.m_poses_blending.pose(Actual,.37f);Near(Actual.c,Initial.c);Previous=Scale;
 }
