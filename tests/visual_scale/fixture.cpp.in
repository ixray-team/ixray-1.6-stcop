void TestAnimationAndMovement(){
 CKinematicsAnimated K;CPHMovementControl M;for(auto&Box:M.boxes){Box.set(-1,0,-2,1,4,2);}M.aabb=M.boxes[0];
 SKeyTable Keys;Keys.Key.Q.identity();Keys.Key.T.set(1,2,3);Fmatrix Parent;Parent.setXYZ(0.3f,0.5f,0.1f);Parent.c.set(3,4,5);
 CBoneInstance Base;Base.construct();K.LL_BoneMatrixBuild(Base,&Parent,Keys);
 Monster Obj;CControlJump Jump;Jump.m_object=&Obj;
 for(float Scale:{0.5f,2.f,3.f,1.f}){
  K.VisualScale=Scale;CBoneInstance Bone;Bone.construct();K.LL_BoneMatrixBuild(Bone,&Parent,Keys);
  Fvector Delta;Delta.sub(Base.mTransform.c,Parent.c).mul(Scale).add(Parent.c);Near(Bone.mTransform.c,Delta);Near(Bone.mTransform.i,Base.mTransform.i);
  M.SetVisualScale(Scale);M.SetVisualScale(Scale);Near(M.aabb.max,Fvector().set(Scale,4*Scale,2*Scale));Near(M.boxes[3].min,Fvector().set(-Scale,0,-2*Scale));
  Obj.Scale=Scale;Near(Jump.get_max_distance(),10);Near(Jump.get_min_distance(),2);
 }
 K.VisualScale=1; // Test fixture has no owned model.
 puts("PASS: animation and root-motion translation, every stance box, size-independent jump reach, no accumulated scale");
}

void TestContinuousGrowth(){
 CBoneData Root(0);Root.bind_transform.identity();Root.bind_transform.c.set(0,1,0);Root.CalculateM2B(Fidentity);
 Root.obb.identity();Root.shape.type=SBoneShape::stSphere;Root.shape.sphere.P.set(0,1,0);Root.shape.sphere.R=.35f;Root.center_of_mass.set(0,1,0);
 vecBones Source={&Root};CBoneInstance Pose;Pose.construct();Pose.mTransform.c.set(0,1,0);Pose.mRenderTransform_old.c.set(7,8,9);
 Pose.param[0]=.37f;CKinematics K;K.bones=&Source;K.bone_instances=&Pose;K.vis.box.set(-1,0,-1,1,2,1);K.vis.sphere.P.set(0,1,0);K.vis.sphere.R=1;
 K.SetVisualScale(1.0001f);CBoneData*Stable=K.bones->front();auto*StableArray=K.InstanceBones.data();
 for(int Frame=1;Frame<=10000;++Frame){
  const float Scale=1.f+Frame*.0001f;K.SetVisualScale(Scale);
  Check(K.bones->front()==Stable && K.InstanceBones.data()==StableArray);Near(K.bones->front()->shape.sphere.R,.35f*Scale);
  Near(Pose.param[0],.37f);Near(Pose.mRenderTransform_old.c,Fvector().set(7,8,9));
 }
 Near(Pose.mTransform.c.y,2);Near(Root.bind_transform.c.y,1);Check(K.HistoryInvalidations==0);
 puts("PASS: 10,000 small growth steps, stable bone allocations, unchanged animation state and render history");
}
