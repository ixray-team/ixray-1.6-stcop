 CBoneInstance* bone_instances=nullptr;int HistoryInvalidations=0;float VisualScale=1.f; vecBones* SharedBones=nullptr;
 xr_vector<xr_unique_ptr<CBoneData>> ScaledBones; vecBones InstanceBones;
