set(LUAJIT_COMPILE_FLAGS /W3 /MP /Zi /FS)
set(LUAJIT_COMPILE_DEFINES -D_CRT_SECURE_NO_DEPRECATE -D_CRT_SECURE_NO_WARNINGS -DLUAJIT_OS=LUAJIT_OS_WINDOWS)
set(LUAJIT_COMPILE_DEFINES_DYNAMIC -DLUA_BUILD_AS_DLL -D "_CRT_STDIO_INLINE=__declspec(dllexport)__inline")
set(LUAJIT_LINK_FLAGS /DEBUG)

set(LUAJIT_VM_MODE peobj)

if(LUAJIT_TARGET_ARCH STREQUAL "x86")
    set(LUAJIT_COMPILE_FLAGS ${LUAJIT_COMPILE_FLAGS} /arch:SSE2)

    set(DASM_FLAGS -D WIN -D JIT -D FFI -D ENDIAN_LE -D FPU)
    set(DASC_FILE ${LUAJIT_ROOT_FOLDER}/src/vm_x86.dasc)
elseif(LUAJIT_TARGET_ARCH STREQUAL "x64")
    set(DASM_FLAGS -D WIN -D JIT -D FFI -D ENDIAN_LE -D FPU -D P64)
    set(DASC_FILE ${LUAJIT_ROOT_FOLDER}/src/vm_x64.dasc)
elseif(LUAJIT_TARGET_ARCH STREQUAL "arm32")
    set(DASM_FLAGS -D WIN -D JIT -D FFI -D ENDIAN_LE -D FPU -D DUALNUM -D HFABI)
    set(DASC_FILE ${LUAJIT_ROOT_FOLDER}/src/vm_arm.dasc)
elseif(LUAJIT_TARGET_ARCH STREQUAL "arm64")
    set(DASM_FLAGS -D WIN -D JIT -D FFI -D ENDIAN_LE -D FPU -D DUALNUM -D HFABI -D P64)
    set(DASC_FILE ${LUAJIT_ROOT_FOLDER}/src/vm_arm64.dasc)
endif()
