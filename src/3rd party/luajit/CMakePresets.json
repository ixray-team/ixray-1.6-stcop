            "hidden": true,
            "inherits": [
                "Common-Parameters-Base"
            ],
            "generator": "Visual Studio 17 2022",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl"
            }
        },
        {
            "name": "VisualStudio-VS2022-Win32",
            "displayName": "VisualStudio-VS2022-Win32",
