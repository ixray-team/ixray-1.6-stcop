{
    "version": 3,

    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "Common-Parameters-Base",
            "displayName": "Common-Parameters-Base",
            "hidden": true,
            "cacheVariables": {
                "LUAJIT_ENABLE_CLI": "ON"
            }
        },

        {
            "name": "VisualStudio-VS2019-Base",
            "displayName": "VisualStudio-VS2019-Base",
            "hidden": true,
            "inherits": [
                "Common-Parameters-Base"
            ],
            "generator": "Visual Studio 16 2019",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl"
            }
        },
        {
            "name": "VisualStudio-VS2019-Win32",
            "displayName": "VisualStudio-VS2019-Win32",
            "inherits": [
                "VisualStudio-VS2019-Base"
            ],
            "architecture": "Win32",
            "binaryDir": "${sourceDir}/build/Win32",
            "installDir": "${sourceDir}/build/Win32/install"
        },
        {
            "name": "VisualStudio-VS2019-x64",
            "displayName": "VisualStudio-VS2019-x64",
