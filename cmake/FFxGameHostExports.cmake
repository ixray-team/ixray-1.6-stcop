# Scan exactly the objects linked into this host; stale objects are not included.
set(AllExports "${FFX_EXPORTS}.all")
execute_process(COMMAND "${CMAKE_COMMAND}" -E __create_def "${AllExports}" "${FFX_HOST_OBJECT_LIST}"
	RESULT_VARIABLE Result ERROR_VARIABLE Error)
if(NOT Result EQUAL 0)
	message(FATAL_ERROR "Cannot collect game-host definitions: ${Error}")
endif()
# CMake first collects host definitions. Keep only references needed by the plugin.
file(STRINGS "${FFX_OBJECT_LIST}" ModuleObjects)
foreach(Object IN LISTS ModuleObjects)
	execute_process(COMMAND "${FFX_DUMPBIN}" /nologo /symbols "${Object}"
		RESULT_VARIABLE Result OUTPUT_VARIABLE Symbols ERROR_VARIABLE Error)
	if(NOT Result EQUAL 0)
		message(FATAL_ERROR "Cannot read module object ${Object}: ${Error}")
	endif()
	string(REPLACE "\r" "" Symbols "${Symbols}")
	string(REPLACE "\n" ";" Lines "${Symbols}")
	foreach(Line IN LISTS Lines)
		if(Line MATCHES "UNDEF.*External.*[|] ([^ ]+)")
			set(Symbol "${CMAKE_MATCH_1}")
			string(REGEX REPLACE "^__imp_" "" Symbol "${Symbol}")
			set("Required_${Symbol}" TRUE)
		endif()
	endforeach()
endforeach()
file(STRINGS "${AllExports}" Definitions)
set(Filtered "EXPORTS\n")
set(Count 0)
foreach(Line IN LISTS Definitions)
	string(STRIP "${Line}" Symbol)
	string(REGEX REPLACE "[ \t]+.*$" "" Symbol "${Symbol}")
	if(DEFINED "Required_${Symbol}")
		string(APPEND Filtered "${Line}\n")
		math(EXPR Count "${Count} + 1")
	endif()
endforeach()
if(Count EQUAL 0)
	message(FATAL_ERROR "No FFxExtendedEntityesLogic game-host exports were found")
endif()
set(Previous "")
if(EXISTS "${FFX_EXPORTS}")
	file(READ "${FFX_EXPORTS}" Previous)
endif()
if(NOT Previous STREQUAL Filtered)
	file(WRITE "${FFX_EXPORTS}" "${Filtered}")
endif()
message(STATUS "FFxExtendedEntityesLogic game-host exports: ${Count}")
