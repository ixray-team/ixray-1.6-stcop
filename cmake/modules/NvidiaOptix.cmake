include_guard(GLOBAL)

# These build tools are downloaded from their authors, never from an IX-Ray mirror.
function(DownloadNvidiaFile Url Destination Hash)
    get_filename_component(Directory "${Destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${Directory}")
    file(DOWNLOAD "${Url}" "${Destination}"
        EXPECTED_HASH "SHA256=${Hash}"
        TLS_VERIFY ON
        STATUS DownloadStatus
        TIMEOUT 600
        INACTIVITY_TIMEOUT 60
        SHOW_PROGRESS
    )
    list(GET DownloadStatus 0 DownloadCode)
    if (NOT DownloadCode EQUAL 0)
        message(FATAL_ERROR "Cannot download NVIDIA dependency ${Url}: ${DownloadStatus}")
    endif()
endfunction()

function(DownloadNvidiaArchive Name Url Hash RootName Result)
    set(Archive "${IXRAY_NVIDIA_DEPS_DIR}/archives/${Name}.zip")
    set(Extracted "${IXRAY_NVIDIA_DEPS_DIR}/${Name}")
    DownloadNvidiaFile("${Url}" "${Archive}" "${Hash}")
    if (NOT EXISTS "${Extracted}/.complete")
        file(ARCHIVE_EXTRACT INPUT "${Archive}" DESTINATION "${Extracted}")
        if (NOT IS_DIRECTORY "${Extracted}/${RootName}")
            message(FATAL_ERROR "Unexpected layout in NVIDIA archive ${Name}")
        endif()
        file(WRITE "${Extracted}/.complete" "${Hash}\n")
    endif()
    set(${Result} "${Extracted}/${RootName}" PARENT_SCOPE)
endfunction()

function(ResetNvidiaCudaCache Root)
    # FindCUDAToolkit caches discovered tools and libraries. Do not mix toolkit versions.
    if (NOT CUDAToolkit_BIN_DIR STREQUAL "${Root}/bin")
        get_cmake_property(CudaCacheVariables CACHE_VARIABLES)
        foreach(Variable IN LISTS CudaCacheVariables)
            if (Variable MATCHES "^CUDA_.*_(LIBRARY|EXECUTABLE)$|^CUDA_CUDART$|^CUDAToolkit_(BIN_DIR|NVCC_EXECUTABLE|SENTINEL_FILE|CUPTI_INCLUDE_DIR)$")
                unset(${Variable} CACHE)
            endif()
        endforeach()
    endif()
endfunction()

function(PrepareNvidiaOptix)
    if (NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        message(FATAL_ERROR "xrLevelBuilder CUDA/OptiX currently requires Windows x64 and MSVC")
    endif()

    set(IXRAY_NVIDIA_DEPS_DIR "${CMAKE_BINARY_DIR}/_deps/nvidia" CACHE PATH "Private CUDA/OptiX build dependency directory; do not publish")
    # Explicit roots select installed SDKs. Otherwise use pinned downloads.
    set(CUDAToolkit_FOUND FALSE)
    set(OptiX_FOUND FALSE)
    if (CUDAToolkit_ROOT OR DEFINED ENV{CUDAToolkit_ROOT})
        if (CUDAToolkit_ROOT)
            ResetNvidiaCudaCache("${CUDAToolkit_ROOT}")
        else()
            ResetNvidiaCudaCache("$ENV{CUDAToolkit_ROOT}")
        endif()
        find_package(CUDAToolkit 12.8 QUIET)
    endif()
    if (OptiX_ROOT OR OptiX_INCLUDE_DIR OR DEFINED ENV{OptiX_ROOT} OR DEFINED ENV{OPTIX_ROOT})
        find_package(OptiX 9 QUIET)
    endif()
    if (CUDAToolkit_VERSION AND CUDAToolkit_VERSION VERSION_LESS 12.8)
        message(FATAL_ERROR "Selected CUDA ${CUDAToolkit_VERSION} is too old. Set CUDAToolkit_ROOT to CUDA >= 12.8 and configure with a fresh CMake cache.")
    endif()
    if (NOT CUDAToolkit_FOUND OR NOT OptiX_FOUND)
        file(MAKE_DIRECTORY "${IXRAY_NVIDIA_DEPS_DIR}")
        file(LOCK "${IXRAY_NVIDIA_DEPS_DIR}/configure.lock" GUARD FUNCTION TIMEOUT 60)
    endif()

    set(Licenses "${CMAKE_CURRENT_BINARY_DIR}/nvidia-licenses")
    # This directory is generated exclusively by this module, including on SDK changes.
    file(REMOVE_RECURSE "${Licenses}")
    file(MAKE_DIRECTORY "${Licenses}")
    if (NOT CUDAToolkit_FOUND)
        set(CudaBase "https://developer.download.nvidia.com/compute/cuda/redist")
        set(CudaRoot "${IXRAY_NVIDIA_DEPS_DIR}/cuda-13.4.3")
        set(Manifest "${IXRAY_NVIDIA_DEPS_DIR}/redistrib_13.4.3.json")
        DownloadNvidiaFile("${CudaBase}/redistrib_13.4.3.json" "${Manifest}"
            "1420d5c676cad98a5ff423d529f116fee92f6b99559a3afdad41e782d6a11dba")
        file(READ "${Manifest}" CudaManifest)
        # CUDA 13 packages CRT and NVVM separately from NVCC.
        foreach(Component IN ITEMS cuda_nvcc cuda_crt cuda_cudart cuda_nvml_dev cccl libnvvm)
            string(JSON RelativePath GET "${CudaManifest}" "${Component}" windows-x86_64 relative_path)
            string(JSON Hash GET "${CudaManifest}" "${Component}" windows-x86_64 sha256)
            get_filename_component(Name "${RelativePath}" NAME_WLE)
            DownloadNvidiaArchive("${Name}" "${CudaBase}/${RelativePath}" "${Hash}" "${Name}" ComponentRoot)
            if (NOT EXISTS "${CudaRoot}/.${Component}")
                file(COPY "${ComponentRoot}/" DESTINATION "${CudaRoot}")
                file(WRITE "${CudaRoot}/.${Component}" "${Hash}\n")
            endif()
            configure_file("${ComponentRoot}/LICENSE" "${Licenses}/CUDA-${Component}.txt" COPYONLY)
            if (Component STREQUAL "cuda_cudart")
                configure_file("${ComponentRoot}/LICENSE" "${CudaRoot}/EULA.txt" COPYONLY)
            endif()
        endforeach()
        set(CUDAToolkit_ROOT "${CudaRoot}")
        ResetNvidiaCudaCache("${CudaRoot}")
        find_package(CUDAToolkit 12.8 REQUIRED)
    else()
        set(CudaLicense "${IXRAY_CUDA_LICENSE_FILE}")
        if (NOT CudaLicense)
            unset(CudaLicense)
            find_file(CudaLicense NAMES EULA.txt LICENSE LICENSE.txt
                PATHS "${CUDAToolkit_LIBRARY_ROOT}" "${CUDAToolkit_BIN_DIR}/.."
                PATH_SUFFIXES . doc NO_DEFAULT_PATH NO_CACHE
            )
        endif()
        if (NOT CudaLicense)
            message(FATAL_ERROR "CUDA license not found. Set IXRAY_CUDA_LICENSE_FILE to the EULA supplied with your toolkit.")
        endif()
        configure_file("${CudaLicense}" "${Licenses}/CUDA-EULA.txt" COPYONLY)
    endif()

    if (NOT OptiX_FOUND)
        DownloadNvidiaArchive(optix-dev-9.0.0
            "https://codeload.github.com/NVIDIA/optix-dev/zip/refs/tags/v9.0.0"
            "461664fda99a901d364996bf048a3dae399ce1162c725e5c1855c336c6c9d0a8"
            optix-dev-9.0.0 OptixRoot
        )
        set(OptiX_ROOT "${OptixRoot}")
        set(OptiX_INCLUDE_DIR "${OptixRoot}/include" CACHE PATH "OptiX include directory" FORCE)
        find_package(OptiX 9 REQUIRED)
    endif()
    get_filename_component(OptixRoot "${OptiX_INCLUDE_DIR}" DIRECTORY)
    set(OptixLicense "${IXRAY_OPTIX_LICENSE_FILE}")
    if (NOT OptixLicense)
        unset(OptixLicense)
        find_file(OptixLicense NAMES LICENSE.txt OptiX_EndUserLicense.pdf
            PATHS "${OptixRoot}" PATH_SUFFIXES . doc NO_DEFAULT_PATH NO_CACHE
        )
    endif()
    if (NOT OptixLicense)
        message(FATAL_ERROR "OptiX license not found. Set IXRAY_OPTIX_LICENSE_FILE to the license supplied with your SDK.")
    endif()
    get_filename_component(LicenseExtension "${OptixLicense}" LAST_EXT)
    configure_file("${OptixLicense}" "${Licenses}/OptiX-EULA${LicenseExtension}" COPYONLY)
    if (EXISTS "${OptixRoot}/license_info.txt")
        configure_file("${OptixRoot}/license_info.txt" "${Licenses}/OptiX-License-Info.txt" COPYONLY)
    endif()

    # Preserve file-level notices without distributing the proprietary SDK headers.
    file(GLOB_RECURSE OptixHeaders CONFIGURE_DEPENDS "${OptiX_INCLUDE_DIR}/*.h")
    set(HeaderNotices "")
    foreach(Header IN LISTS OptixHeaders)
        file(READ "${Header}" HeaderText)
        string(FIND "${HeaderText}" "*/" NoticeEnd)
        if (HeaderText MATCHES "^/\\*" AND NOT NoticeEnd EQUAL -1)
            math(EXPR NoticeEnd "${NoticeEnd} + 2")
            string(SUBSTRING "${HeaderText}" 0 ${NoticeEnd} Notice)
            file(RELATIVE_PATH HeaderName "${OptiX_INCLUDE_DIR}" "${Header}")
            string(APPEND HeaderNotices "${HeaderName}\n${Notice}\n\n")
        endif()
    endforeach()
    file(CONFIGURE OUTPUT "${Licenses}/OptiX-Header-Notices.txt" CONTENT "@HeaderNotices@" @ONLY)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../doc/NVIDIA-Dependencies.txt" "${Licenses}/README.txt" COPYONLY)

    foreach(RequiredTarget IN ITEMS CUDA::cudart_static CUDA::nvml)
        if (NOT TARGET ${RequiredTarget})
            message(FATAL_ERROR "Incomplete CUDA toolkit: ${RequiredTarget} is missing")
        endif()
    endforeach()
    if (NOT EXISTS "${CUDAToolkit_NVCC_EXECUTABLE}")
        message(FATAL_ERROR "NVCC is required to compile CuTrace.ptx")
    endif()
    set(CUDAToolkit_NVCC_EXECUTABLE "${CUDAToolkit_NVCC_EXECUTABLE}" PARENT_SCOPE)
    set(CUDAToolkit_INCLUDE_DIRS "${CUDAToolkit_INCLUDE_DIRS}" PARENT_SCOPE)
    set(CUDAToolkit_VERSION "${CUDAToolkit_VERSION}" PARENT_SCOPE)
    set(OptiX_INCLUDE_DIRS "${OptiX_INCLUDE_DIRS}" PARENT_SCOPE)
    set(OptiX_VERSION "${OptiX_VERSION}" PARENT_SCOPE)
    set(IXRAY_OPTIX_HEADERS "${OptixHeaders}" PARENT_SCOPE)
    set(IXRAY_NVIDIA_LICENSE_DIR "${Licenses}" PARENT_SCOPE)
endfunction()
